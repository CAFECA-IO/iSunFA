{
  "name": "isunfa",
  "version": "0.12.0+212",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "npm run initial_wallet && npm run initial_lance_db && prisma generate && npm run lint && next dev",
    "build": "npm run initial_wallet && npm run initial_lance_db && prisma generate && npm run lint && next build",
    "start": "npm run build && next start",
    "seed": "npx tsx scripts/seed/seed.ts",
    "seed_attendance_demo": "npx tsx scripts/seed/seed_attendance_demo.ts",
    "seed_leave_overtime_demo": "npx tsx scripts/seed/seed_leave_overtime_demo.ts",
    "seed_hr_demo": "npm run seed_attendance_demo && npm run seed_leave_overtime_demo",
    "lint": "eslint",
    "test": "npm run lint && jest --passWithNoTests && npm run test:tz",
    "test:tz": "node scripts/jest_tz.mjs",
    "swarm": "npm run build && next start -p 10020",
    "worker": "npx tsx scripts/run_worker.ts",
    "executor": "npx tsx scripts/run_executor.ts",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "integration_test": "npx tsx scripts/run_integration_test.ts",
    "service": "npx tsx scripts/run_service.ts",
    "initial_wallet": "npx tsx scripts/initial_wallet.ts",
    "build_contract": "npx hardhat compile",
    "deploy_contract": "npx hardhat run scripts/deploy_contract.ts",
    "version": "npx tsx scripts/bump_version.ts",
    "initial_lance_db": "npx tsx scripts/init_lance_db.ts"
  },
  "dependencies": {
    "@erc3643org/erc-3643": "^4.1.3",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@lancedb/lancedb": "^0.33.0",
    "@llamaindex/llama-cloud": "^2.9.0",
    "@next/third-parties": "^16.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@passwordless-id/webauthn": "^2.3.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.8.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/geojson": "^7946.0.16",
    "centrifuge": "^5.7.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^7.0.0",
    "csv-stringify": "^6.7.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "ethers": "^6.16.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "html5-qrcode": "^2.3.8",
    "jest": "^30.3.0",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.24.0",
    "md-to-pdf": "^5.2.5",
    "marked": "^16.4.2",
    "mermaid": "^11.13.0",
    "next": "16.3.0",
    "node-cron": "^4.2.1",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.8",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-usestateref": "^2.0.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.1",
    "swr": "^2.4.1",
    "viem": "^2.52.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/csv-parse": "^1.1.12",
    "@types/csv-stringify": "^3.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": {
      "glob": "^13.0.6"
    },
    "inflight": "npm:lru-cache@^11.0.0",
    "eslint-plugin-react": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
