{
  "name": "isunfa",
  "version": "0.12.0+51",
  "private": true,
  "scripts": {
    "dev": "npm run lint && prisma generate && next dev",
    "build": "npm run lint && prisma generate && npx hardhat compile && next build",
    "start": "npm run build && next start",
    "lint": "eslint",
    "test": "npm run lint && jest --passWithNoTests",
    "update-version": "npm run lint && echo 'Updating version...'",
    "swarm": "npm run build && next start -p 10020",
    "worker": "npx tsx scripts/worker.run.ts",
    "task-manager": "npx tsx scripts/task_manager.run.ts",
    "prettier": "prettier --write .",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "init": "npx hardhat run scripts/deploy.ts --network isuncoin_mainnet",
    "test-contract": "while true; do npx tsx scripts/test_smart_contract.ts; sleep 1; done"
  },
  "dependencies": {
    "@erc3643org/erc-3643": "^4.1.3",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@next/third-parties": "^16.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@onchain-id/solidity": "^2.2.1",
    "@openzeppelin/contracts": "^4.9.3",
    "@openzeppelin/contracts-upgradeable": "^4.9.3",
    "@passwordless-id/webauthn": "^2.3.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jest": "^30.3.0",
    "jose": "^6.1.3",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.13.0",
    "next": "16.2.1",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-to-print": "^3.3.0",
    "react-usestateref": "^2.0.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.6",
    "@tailwindcss/postcss": "^4",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "chai": "^6.2.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "ethers": "^6.16.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": {
      "glob": "^13.0.6"
    },
    "inflight": "npm:lru-cache@^11.0.0"
  },
  "type": "module",
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "^0.27.4",
    "@nomicfoundation/solidity-analyzer-darwin-arm64": "^0.1.2"
  }
}