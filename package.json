{
  "name": "isunfa",
  "version": "0.12.0+117",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "npm run initial_wallet && npm run lint && prisma generate && next dev",
    "build": "npm run initial_wallet && npm run lint && prisma generate && next build",
    "start": "npm run build && next start",
    "seed": "npx tsx scripts/seed/seed.ts",
    "lint": "eslint",
    "test": "npm run lint && jest --passWithNoTests",
    "swarm": "npm run build && next start -p 10020",
    "worker": "npx tsx scripts/run_worker.ts",
    "format": "prettier --ignore-path .gitignore --write \"**/*.+(js|ts|json)\"",
    "integration_test": "npx tsx scripts/run_integration_test.ts",
    "service": "npx tsx scripts/run_service.ts",
    "initial_wallet": "npx tsx scripts/initial_wallet.ts",
    "build_contract": "npx hardhat compile",
    "deploy_contract": "npx hardhat run scripts/deploy_contract.ts",
    "version": "npx tsx scripts/bump_version.ts"
  },
  "dependencies": {
    "@erc3643org/erc-3643": "^4.1.3",
    "@google/generative-ai": "^0.24.1",
    "@headlessui/react": "^2.2.9",
    "@next/third-parties": "^16.1.6",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.1",
    "@passwordless-id/webauthn": "^2.3.1",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/geojson": "^7946.0.16",
    "cheerio": "^1.2.0",
    "csv-stringify": "^6.7.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^13.0.0",
    "file-saver": "^2.0.5",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "^0.14.0",
    "jest": "^30.3.0",
    "jose": "^6.1.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.7.0",
    "maplibre-gl": "^5.24.0",
    "mermaid": "^11.13.0",
    "next": "16.2.6",
    "p-limit": "^7.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "qrcode.react": "^4.2.0",
    "react": "19.2.6",
    "react-barcode": "^1.6.1",
    "react-dom": "19.2.6",
    "react-map-gl": "^8.1.1",
    "react-markdown": "^10.1.0",
    "react-usestateref": "^2.0.0",
    "recharts": "^3.6.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.1.1",
    "@nomicfoundation/solidity-analyzer-darwin-arm64": "^0.1.2",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/jest": "^30.0.0",
    "@types/node": "^25",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "prisma": "^7.2.0",
    "tailwindcss": "^4",
    "typescript": "^6",
    "typescript-eslint": "^8.51.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  },
  "overrides": {
    "glob": "^13.0.6",
    "test-exclude": {
      "glob": "^13.0.6"
    },
    "inflight": "npm:lru-cache@^11.0.0"
  }
}
