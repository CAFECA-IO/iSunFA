generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id String @id @default(uuid())

  // Info: (20260112 - Tzuhan) RWA Identity Contract (ONCHAINID)
  identityAddress String? @map("identity_address")

  //  Info: (20260112 - Tzuhan) 用戶的錢包 (address) 是這個 RWA Identity Contract 合約的 Owner
  address          String   @unique
  pubKeyX          String?  @map("pub_key_x")
  pubKeyY          String?  @map("pub_key_y")
  credentialId     String?  @unique @map("credential_id")
  currentChallenge String?  @map("current_challenge")
  name             String?
  imageUrl         String?  @map("image_url")
  kycData          Json?    @map("kyc_data")
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders                Order[]
  analyses              Analysis[]
  coefficients          Coefficient[]
  comments              Comment[]
  receivedReplies       Comment[]              @relation("CommentRecipient")
  reactions             Reaction[]
  paymentMethods        PaymentMethod[]
  paymentTransactions   PaymentTransaction[]
  journals              Journal[]
  teamMembers           TeamMember[]
  teamInvitations       TeamInvitation[]       @relation("Inviter")
  // Info: (20260817 - Luphia) 此帳號用掉的邀請（稽核用；見 TeamInvitation.acceptedByUserId）
  acceptedInvitations   TeamInvitation[]       @relation("InvitationAcceptor")
  // Info: (20260818 - Luphia) 由此帳號撤回的邀請（稽核用；見 TeamInvitation.revokedByUserId）
  revokedInvitations    TeamInvitation[]       @relation("InvitationRevoker")
  // Info: (20260817 - Luphia) 費思長期記憶（一個團隊一份，見 FaithMemory）
  faithMemories         FaithMemory[]
  auditLogs             AuditLog[]
  vouchers              Voucher[]
  esgRecords            EsgRecord[]
  checkins              Checkin[]
  reportShareTokens     ReportShareToken[]     @relation("ReportSharer")
  campaignRegistrations CampaignRegistration[]
  coupons               Coupon[]
  pdfEditorDocuments    PdfEditorDocument[]    @relation("PdfEditorDocumentCreator")
  accountingAccounts    AccountingAccount[]
  teamWalletAllocations TeamWalletAllocation[]
  identities            UserIdentity[]
  custodialKey          UserCustodialKey?
  // Info: (20260813 - Julian) 綁定的員工檔。員工要能自己打卡就必須從登入身分找回它
  employee              Employee?

  @@index([address])
  @@map("user")
}

/**
 * Info: (20260809 - Luphia) 第三方身分綁定（Google / Apple / ...）。
 * 一個 User 可綁多個 provider，同一 provider 只能綁一個外部帳號；
 * (provider, providerUserId) 為全域唯一，避免同一個 Google 帳號登入到兩個 User。
 */
model UserIdentity {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String
  providerUserId String    @map("provider_user_id")
  email          String?
  emailVerified  Boolean   @default(false) @map("email_verified")
  displayName    String?   @map("display_name")
  avatarUrl      String?   @map("avatar_url")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([provider, providerUserId])
  // Info: (20260811 - Luphia) 不另建 @@index([userId])：複合唯一索引的最左前綴已涵蓋以 userId 查詢
  @@unique([userId, provider])
  @@map("user_identity")
}

/**
 * Info: (20260809 - Luphia) 託管式 SCW 簽章金鑰。
 * 僅用於「沒有 passkey」的第三方登入使用者：伺服器代管其 P-256 私鑰，
 * 私鑰以 AES-256-GCM 加密後存放（見 src/lib/auth/key_vault.ts），明文永不落盤。
 * 使用者之後補綁 passkey 時，可將 SCW 擁有者換成 passkey 公鑰並廢除此列。
 */
model UserCustodialKey {
  userId              String   @id @map("user_id")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId        String   @unique @map("credential_id")
  pubKeyX             String   @map("pub_key_x")
  pubKeyY             String   @map("pub_key_y")
  encryptedPrivateKey String   @map("encrypted_private_key")
  iv                  String
  authTag             String   @map("auth_tag")
  keyVersion          Int      @default(1) @map("key_version")
  algorithm           String   @default("AES-256-GCM")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("user_custodial_key")
}

model Team {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  teamMembers           TeamMember[]
  teamInvitations       TeamInvitation[]
  accountBooks          AccountBook[]
  teamSubscription      TeamSubscription?
  teamWallet            TeamWallet?
  teamWalletAllocations TeamWalletAllocation[]
  teamQuotaUsages       TeamQuotaUsage[]
  // Info: (20260817 - Luphia) 團隊內各成員的費思長期記憶（見 FaithMemory）
  faithMemories         FaithMemory[]

  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      TeamRole
  /**
   * Info: (20260818 - Luphia) 這段成員資格由哪一封邀請而來（第六輪第 1 條）。
   *
   * 為什麼需要它：`TeamInvitation.acceptedEmailMatch` 記下「接受者的已驗證信箱與
   * 受邀信箱是否相符」，而成員清單要據此對管理職顯示標記。問題是「這個標記描述的
   * 是不是**現在**這段成員資格」——同一個人可能被移出再加回，舊邀請的紀錄不該
   * 掛在新的成員資格上。
   *
   * 先前用時間戳推論（邀請的 `acceptedAt` 對成員的 `createdAt`），而那兩個值來自
   * **兩個時鐘**：`acceptedAt` 是 app 在 route 一開始取的 `Date.now()`，
   * `createdAt` 的預設是資料庫的 `CURRENT_TIMESTAMP`。實測差 +19ms（中間隔著五次
   * 以上查詢），於是比較永遠不成立、標記永遠不顯示；而在 app 與 DB 時鐘有偏移的
   * 部署上它又會零星地出現——比永遠不出現更難查。
   *
   * 這一欄把那個**關聯**直接寫下來：一次外鍵比對，不看任何時鐘。
   *
   * NULL 的語意是「這段成員資格不是邀請來的」——以錢包位址直接加入、後台加入、
   * seed 建立的成員都是 NULL，而他們本來就沒有信箱可比對。歷史資料同樣留 NULL
   * （猜一封邀請比留空更糟），因此不需要回填。
   */
  joinedByInvitationId String?         @map("joined_by_invitation_id")
  joinedByInvitation   TeamInvitation? @relation("MembershipOrigin", fields: [joinedByInvitationId], references: [id])
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  // Info: (20260818 - Luphia) 標記查詢以 (team_id, joined_by_invitation_id) 撈本團隊的成員
  @@index([teamId, joinedByInvitationId])
  @@map("team_member")
}

/**
 * Info: (20260817 - Luphia) 費思個人化長期記憶（規範 ai_and_analytics/faith_personal_memory.md）。
 *
 * 作用範圍是 `(userId, teamId)` 而非純 per-user，理由是刪除觸發必須與作用範圍同鍵：
 * 90 天的起算點是「**團隊的**付費訂閱終止」，若記憶為全域 per-user，
 * 一位同時屬於 A（仍在訂閱）與 B（剛終止）兩個團隊的成員，「該不該刪」就沒有
 * 決定論答案。另一個理由是隔離：事務所的一位成員常同時服務多家客戶，
 * 把 A 客戶的科目慣例帶進 B 客戶的對話是實質的資訊外洩（規範 §3.1）。
 */
model FaithMemory {
  id String @id @default(uuid())

  userId String @map("user_id")
  teamId String @map("team_id")

  /**
   * Info: (20260817 - Luphia) 記憶項目密文（AES-256-GCM，沿用 key_vault 的 FAITH_MEMORY 子金鑰）。
   * 明文結構為 IFaithMemoryItem[]，**整包加密**而非逐條：記憶一律整包讀取用於組 prompt，
   * 逐條加密只是多存 N 組 IV 與標籤。
   */
  itemsCipher String @map("items_cipher") @db.Text
  itemsIv     String @map("items_iv")
  itemsTag    String @map("items_tag")
  keyVersion  Int    @map("key_version")

  // Info: (20260817 - Luphia) 條目數（明文計數，供上限判斷與觀測，不含任何內容）
  itemCount Int @default(0) @map("item_count")

  /**
   * Info: (20260817 - Luphia) 到期刪除時點（訂閱終止日 + 保留天數設定）。
   * null = 訂閱有效中，不排定刪除；恢復訂閱時清回 null。
   * 期限**算好存下來**而非每次推導：推導點一多，條款承諾的日期就會出現兩種算法。
   */
  expiresAt DateTime? @map("expires_at")

  /**
   * Info: (20260818 - Luphia) 這個期限是**誰排的**（第三輪 C-8）。
   *
   * 保留期守護行程每 6 小時對帳一次，付費團隊即清掉 `expiresAt`。少了這一欄，
   * 它會把**別人排的**期限一起清掉——例如帳戶終止的 30 天寬限期：
   * 團隊仍在訂閱時，那個期限每 6 小時被清一次，記憶永遠不會被刪，
   * 而條款 §3.7 寫的是「與第 9 條期間並存時以較早屆至者為準」。
   *
   * 值為 FAITH_MEMORY_DELETION_REASON；對帳只設定與清除自己那一種。
   */
  expiryReason String? @map("expiry_reason")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])
  team Team @relation(fields: [teamId], references: [id])

  @@unique([userId, teamId])
  // Info: (20260817 - Luphia) 保留期守護行程的掃描索引（WHERE expires_at <= now）
  @@index([expiresAt])
  @@map("faith_memory")
}

/**
 * Info: (20260817 - Luphia) 記憶刪除的稽核列。
 * **不得含記憶內容**——否則「刪除」等於搬家（規範 §3.2）。
 */
model FaithMemoryDeletionLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  teamId    String   @map("team_id")
  itemCount Int      @map("item_count")
  // Info: (20260817 - Luphia) FAITH_MEMORY_DELETION_REASON（src/constants/faith_memory.ts）
  reason    String
  deletedAt DateTime @default(now()) @map("deleted_at")

  @@index([userId, teamId])
  @@map("faith_memory_deletion_log")
}

model TeamInvitation {
  id             String   @id @default(uuid())
  teamId         String   @map("team_id")
  team           Team     @relation(fields: [teamId], references: [id])
  inviterId      String   @map("inviter_id")
  inviter        User     @relation("Inviter", fields: [inviterId], references: [id])
  /**
   * Info: (20260815 - Luphia) 錢包位址邀請的受邀者。email 邀請時為 null——
   * 對方還沒註冊，此時不存在位址（接受時才建立成員關係）。
   */
  inviteeAddress String?   @map("invitee_address")
  /**
   * Info: (20260815 - Luphia) Email 邀請（規範 §4 / P4）。
   * 屬個資，僅用於寄送本次邀請（《隱私權政策》§1）。
   */
  inviteeEmail   String?   @map("invitee_email")
  /**
   * Info: (20260815 - Luphia) 邀請 token 的 SHA-256 雜湊。
   * 明文只存在於寄出的那封信裡：資料庫外洩不等於任何人都能加入團隊。
   */
  tokenHash      String?   @unique @map("token_hash")
  // Info: (20260815 - Luphia) 邀請有效期限；逾期即失效（席次不退費但可再用於邀請他人）
  expiresAt      DateTime? @map("expires_at")
  /**
   * Info: (20260816 - Luphia) 「同一團隊、同一對象，同時只能有一封待接受邀請」的唯一鍵。
   *
   * 值由 `buildPendingInviteKey` 產生（`{teamId}:mail:{email}` 或 `{teamId}:addr:{address}`），
   * **僅在 PENDING 期間有值**，接受後設回 NULL。Postgres 允許多個 NULL，
   * 因此效果等同 partial unique index，而它寫在 schema 裡、`prisma db push` 帶得走。
   *
   * 取代原本的 `@@unique([teamId, inviteeEmail, status])`：把 status 放進鍵裡
   * 會連歷史列一起約束，於是「離職後再邀請同一個人」在**接受的那一刻**撞上
   * 舊的 ACCEPTED 列，永遠加不進來，而席次費已經扣了。詳見 pending_invite_key.ts。
   */
  pendingKey     String?   @unique @map("pending_key")
  role           TeamRole
  // Info: (20260818 - Luphia) TEAM_INVITATION_STATUS：PENDING / ACCEPTED / REJECTED / REVOKED
  status         String    @default("PENDING")
  /**
   * Info: (20260817 - Luphia) 實際用掉這封邀請的帳號。
   *
   * 稽核軌跡在此之前是斷的：邀請記的是 email，成員記的是帳號，而兩者之間
   * 沒有任何欄位相連——「邀請 a@x.com」與「成員 0xAb…」是不是同一個人，
   * 從資料庫看不出來。這一欄不宣稱那個帳號屬於該信箱（見下方 acceptedEmailMatch），
   * 只誠實記錄「這封邀請被這個帳號用掉了」。
   */
  acceptedByUserId String?  @map("accepted_by_user_id")
  acceptedBy       User?    @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id])
  // Info: (20260817 - Luphia) 接受時點。不靠 updatedAt——那一欄任何後續更新都會動
  acceptedAt       DateTime? @map("accepted_at")
  /**
   * Info: (20260817 - Luphia) 受邀信箱與接受者已驗證信箱的比對結果（INVITE_EMAIL_MATCH）。
   *
   * **記錄，不阻擋**：工作信箱收到邀請、用個人 Google 帳號登入是完全正常的行為。
   * 位址邀請（無 inviteeEmail）為 null——不適用，而不是「比對失敗」。
   *
   * `UNAVAILABLE` 是常態而非異常：本站的 passkey 註冊全程不問 email
   * （`User` 沒有 email 欄位，email 只存在於第三方綁定 `UserIdentity`），
   * 因此以 FIDO2 註冊的受邀者根本沒有可比對的信箱。
   */
  acceptedEmailMatch String? @map("accepted_email_match")
  /**
   * Info: (20260818 - Luphia) 撤回邀請的稽核（第三輪 D）。
   *
   * 撤回原本是**實刪除**，於是「曾經邀請過誰、由誰撤回」在撤回之後查不到——
   * 而同一條路徑上的「拒絕」是改狀態，兩者的稽核強度不一致。
   * 邀請一個人是會動到信用卡並對外寄信的動作，它的撤回不該無痕。
   *
   * 唯一仍該實刪的是**信寄不出去時的回滾**（見 `deleteInvitation`）：
   * 一封沒寄出去的邀請不是歷史紀錄，留著只會佔住 `pendingKey`。
   */
  // Info: (20260818 - Luphia) 由這封邀請開始的成員資格（第六輪第 1 條，通常 0 或 1 段）
  joinedMembers   TeamMember[] @relation("MembershipOrigin")
  revokedByUserId String?   @map("revoked_by_user_id")
  revokedBy       User?     @relation("InvitationRevoker", fields: [revokedByUserId], references: [id])
  revokedAt       DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Info: (20260816 - Luphia) 席次占用數的查詢條件（teamId + status + expiresAt），取代舊複合唯一鍵留下的索引
  @@index([teamId, status])
  @@map("team_invitation")
}

/**
 * Info: (20260807 - Luphia)
 * 團隊錢包與訂閱額度（設計書 documents/architecture/team_wallet_and_subscription_quota.md、ADR 015）。
 * 團隊點數採離鏈決定論帳本（C 案混合制：離鏈營運 + 每日 merkle 鏈上錨定），
 * 金額一律 BigInt 零誤差；TeamWalletLedger 為 append-only，更正僅允許反向分錄。
 */
model TeamSubscription {
  id                 String   @id @default(uuid())
  teamId             String   @unique @map("team_id")
  team               Team     @relation(fields: [teamId], references: [id])
  planId             String   @default("free") @map("plan_id") // Info: (20260807 - Luphia) PLAN 常數 (free/team/business)
  status             String   @default("ACTIVE") // Info: (20260807 - Luphia) TEAM_SUBSCRIPTION_STATUS 常數
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  autoRenew          Boolean  @default(true) @map("auto_renew")
  latestOrderId      String?  @map("latest_order_id")
  // Info: (20260814 - Luphia) 已付費席次數：訂閱以「席次 × 單價」計費，續訂時依當下成員數重算
  seats              Int      @default(1)
  /**
   * Info: (20260814 - Luphia) 本期單價快照（TWD 整數，單一席次）。
   * 快照而非即時查表：期中加人要按「當初買的價格」比例補收，
   * 若期間調過價，用新價補收等於偷偷改了這一期的合約。
   */
  unitPrice          Int      @default(0) @map("unit_price")
  /**
   * Info: (20260821 - Luphia) 本期計費週期（BILLING_INTERVAL 常數：month/year）。
   * 先前只存在最後一張訂單的 data 裡，於是「期中加人的補收分母該是幾天」
   * 在資料層答不出來（review #6687 二輪高-1）。快照在這裡，與 unitPrice 同理：
   * 期中補收要按「當初買的週期」算，不是按下一張訂單的。
   *
   * Info: (20260821 - Luphia) **可為 NULL 且刻意不給預設值**（review #6687 三輪）。
   * 本專案沒有 migrations 目錄，`db push` 之後既有列一律拿到欄位的預設值——
   * 若預設 `"month"`，年繳列會拿到一個**完全合法、只是錯的**值，`quoteSeatAddition`
   * 的守門（只認不合法的值）看不到它，於是回填腳本跑完之前，年繳團隊加人的
   * 補收分母是 30 天而不是 365：多收約 12 倍，且 5 席以上剛好撞不到 2 倍上限。
   * NULL 讓現成的守門直接生效（擋下、要求回填），與 `unitPrice` 選
   * `TW_SEAT_PRICE_MISSING` 而不走零元路徑是同一個判斷。
   */
  billingInterval    String?  @map("billing_interval")
  /**
   * Info: (20260820 - Luphia) 已排程、**於當期屆滿時才生效**的方案（降級用）。
   * 退款政策 §2.1 承諾「取消或降級於當前結算週期結束後自動生效」，因此降級不得
   * 立即改 `planId`——當期權益必須維持原方案（使用者已付到期末）。
   * NULL＝沒有排程中的變更。升級不走這一欄（立即生效）。
   */
  pendingPlanId      String?  @map("pending_plan_id")
  /**
   * Info: (20260819 - Luphia) 鏈上訂閱會員卡（DynamicKYCMembership ERC721）的同步狀態。
   * 卡片是訂閱的鏡像：權益判斷一律讀本表其他欄位，不讀鏈（見 constants/subscription_nft）。
   * `nftSyncedAt` 為 NULL 就是「待同步」，也就是 worker 的工作佇列，
   * 因此既有列不需要回填——它們天生就在佇列裡。
   * tokenId 以字串存：uint256 放不進 Int，也不需要做算術。
   */
  nftTokenId         String?   @map("nft_token_id")
  // Info: (20260819 - Luphia) 卡片鑄給誰（當時的 OWNER 地址）；換 OWNER 不搬卡，留著才查得出來
  nftOwnerAddress    String?   @map("nft_owner_address")
  // Info: (20260819 - Luphia) 上次成功寫上鏈的內容指紋（plan:periodEnd:seats），冪等判斷用
  nftFingerprint     String?   @map("nft_fingerprint")
  nftSyncedAt        DateTime? @map("nft_synced_at")
  // Info: (20260819 - Luphia) 連續失敗次數與最後一次錯誤：達上限即停手等人介入（CLAUDE.md §6）
  nftSyncAttempts    Int       @default(0) @map("nft_sync_attempts")
  nftSyncError       String?   @map("nft_sync_error")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("team_subscription")
}

