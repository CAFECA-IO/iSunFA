  // Info: (20260416 - Julian) 關聯的碳排放係數
  coefficientId String?      @map("coefficient_id")
  coefficient   Coefficient? @relation(fields: [coefficientId], references: [id])

  // Info: (20260421 - Julian) 關聯的排放源
  emissionSourceId String?         @map("emission_source_id")
  emissionSource   EmissionSource? @relation(fields: [emissionSourceId], references: [id])

  // Info: (20260324 - Julian) AI 分析的備註
  aiNote String @default("") @map("ai_note") @db.Text

  // Info: (20260703 - Tzuhan) 產品碳足跡分攤紀錄
