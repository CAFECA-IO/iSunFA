generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id String @id @default(uuid())

  // Info: (20260112 - Tzuhan) RWA Identity Contract (ONCHAINID)
  identityAddress String? @map("identity_address")

  //  Info: (20260112 - Tzuhan) 用戶的錢包 (address) 是這個 RWA Identity Contract 合約的 Owner
  address          String   @unique
  pubKeyX          String?  @map("pub_key_x")
  pubKeyY          String?  @map("pub_key_y")
  credentialId     String?  @unique @map("credential_id")
  currentChallenge String?  @map("current_challenge")
  name             String?
  imageUrl         String?  @map("image_url")
  kycData          Json?    @map("kyc_data")
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders              Order[]
  analyses            Analysis[]
  comments            Comment[]
  receivedReplies     Comment[]            @relation("CommentRecipient")
  reactions           Reaction[]
  paymentMethods      PaymentMethod[]
  paymentTransactions PaymentTransaction[]
  journals            Journal[]
  teamMembers         TeamMember[]
  teamInvitations     TeamInvitation[]     @relation("Inviter")
  auditLogs           AuditLog[]
  vouchers            Voucher[]
  esgRecords          EsgRecord[]
  checkins            Checkin[]
  reportShareTokens   ReportShareToken[]   @relation("ReportSharer")

  @@index([address])
  @@map("user")
}

model Team {
  id              String           @id @default(uuid())
  name            String
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")
  teamMembers     TeamMember[]
  teamInvitations TeamInvitation[]
  accountBooks    AccountBook[]

  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("team_member")
}

model TeamInvitation {
  id             String   @id @default(uuid())
  teamId         String   @map("team_id")
  team           Team     @relation(fields: [teamId], references: [id])
  inviterId      String   @map("inviter_id")
  inviter        User     @relation("Inviter", fields: [inviterId], references: [id])
  inviteeAddress String   @map("invitee_address")
  role           TeamRole
  status         String   @default("PENDING") // Info: (20260325 - Agent) PENDING, ACCEPTED, REJECTED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("team_invitation")
}

model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  type            String
  amount          Int
  unit            String   @default("ICP")
  data            Json
  status          String   @default("PENDING")
  challenge       String
  signature       String?
  transactionHash String?  @map("transaction_hash")
  mission         String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  analysis            Analysis[]
  paymentTransactions PaymentTransaction[]
  receipt             Receipt?

  @@map("order")
}

// Info: (20260128 - Luphia) Analysis 直接將 data 與 result 放在 mission 裡面
model Analysis {
  id      String @id
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id])
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])
  type    String
  data    Json
  result  Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags              AnalysisTag[]
  reportShareTokens ReportShareToken[]
  files             File[]
  comments          Comment[]
  reactions         Reaction[]

  @@map("analysis")
}

// Info: (20260226 - Julian) 上傳檔案：儲存 hash
model File {
  id       String  @id @default(uuid())
  hash     String
  fileName String? @map("file_name")

  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId String?   @map("analysis_id")

  journals   Journal[]
  vouchers   Voucher[]
  esgRecords EsgRecord[]

  @@map("file")
}

// Info: (20260212 - Julian) 評論：支援巢狀回覆
model Comment {
  id         String   @id @default(uuid())
  content    String   @db.Text
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  analysisId String   @map("analysis_id")
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  // Info: (20260212 - Julian) 巢狀邏輯
  parentCommentId String?   @map("parent_comment_id")
  parentComment   Comment?  @relation("ReplyTo", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("ReplyTo")

  // Info: (20260212 - Julian) 回覆對象
  replyToUserId String? @map("reply_to_user_id")
  replyToUser   User?   @relation("CommentRecipient", fields: [replyToUserId], references: [id])

  createdAt      DateTime   @default(now()) @map("created_at")
  deletedAt      DateTime?  @map("deleted_at")
  isProfessional Boolean    @default(false) @map("is_professional")
  reactions      Reaction[]

  @@map("comment")
}

// Info: (20260212 - Julian) 討論串標籤
model Tag {
  id       String        @id @default(uuid())
  name     String        @unique
  analyses AnalysisTag[]

  @@map("tag")
}

enum ReactionType {
  LIKE
  DISLIKE
}

// Info: (20260212 - Julian) 討論串的按讚
model Reaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260212 - Julian) 評價類型：是讚還是倒讚
  type ReactionType

  // Info: (20260212 - Julian) 關聯使用者
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Info: (20260212 - Julian) 關聯分析/對話
  analysisId String?   @map("analysis_id")
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  // Info: (20260212 - Julian) 關聯評論
  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id])

  // Info: (20260212 - Julian) 核心約束：一個使用者對同一個物件只能有一個評價
  @@unique([userId, analysisId])
  @@unique([userId, commentId])
  @@map("reaction")
}

// Info: (20260311 - Tzuhan) Analysis - Tags
model AnalysisTag {
  analysisId String   @map("analysis_id")
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([analysisId, tagId])
  @@map("analysis_tag")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  provider  String
  token     String
  data      Json?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions PaymentTransaction[]

  @@map("payment_method")
}

// Info: (20260302 - Tzuhan) 獨立的 PaymentTransaction Table，減少支付模組的耦合性
model PaymentTransaction {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id])
  paymentMethodId String?        @map("payment_method_id")
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  orderId         String?        @map("order_id")
  order           Order?         @relation(fields: [orderId], references: [id])
  provider        String
  amount          Int
  status          String         @default("PENDING") // Info: (20260302 - Tzuhan) PENDING, SUCCESS, FAILED
  errorMessage    String?        @map("error_message")
  rawData         Json?          @map("raw_data")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("payment_transaction")
}

model Receipt {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Int
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt")
}

enum AIAnalysisStatus {
  PENDING // Info: (20260318 - Julian) 尚未開始
  PROCESSING // Info: (20260318 - Julian) 正在處理
  COMPLETED // Info: (20260318 - Julian) 已完成
  FAILED // Info: (20260318 - Julian) 失敗
}

// Info: (20260304 - Julian) 憑證/日記帳
model Journal {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  text           String           @db.Text // Info: (20260304 - Julian) AI 辨識出的文字結果
  analysisStatus AIAnalysisStatus @default(PENDING) @map("analysis_status")
  tradingDate    DateTime         @default(now()) @map("trading_date")
  confidence     Int              @default(0) @map("confidence")
  isVerified     Boolean          @default(false) @map("is_verified")
  aiNote         String           @map("ai_note") @db.Text // Info: (20260325 - Julian) AI 分析的備註

  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  // Info: (20260305 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?

  deletedAt DateTime? @map("deleted_at")

  @@map("journal")
}

// Info: (20260305 - Julian) 帳本
model AccountBook {
  id            String    @id @default(uuid())
  name          String
  country       String
  currency      String
  rule          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  enterpriseId  String?   @map("enterprise_id")
  esgIndustryId Int?      @map("esg_industry_id")

  // Info: (20260306 - Luphia) 帳本所屬的團隊
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id])

  // Info: (20260305 - Julian) 一個帳本可以有多個憑證
  journals Journal[]

  // Info: (20260310 - Julian) 一個帳本可以有多個傳票
  vouchers Voucher[]

  // Info: (20260306 - Julian) 一個帳本可以有多個編輯紀錄
  auditLogs AuditLog[]

  // Info: (20260312 - Julian) 帳本對應的 ESG 紀錄
  esgRecords EsgRecord[]

  // Info: (20260322 - Luphia) 帳本對應的各年度 ESG 目標
  esgTargets EsgTarget[]

  // Info: (20260413 - Julian) 帳本對應的係數
  coefficients Coefficient[]

  // Info: (20260421 - Julian) 帳本對應的排放源
  emissionSources EmissionSource[]

  @@map("account_book")
}

// Info: (20260306 - Julian) 資料編輯 log
enum AuditLogDataType {
  JOURNAL
  VOUCHER
  ESG_RECORD
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260306 - Julian) 編輯的資料類型 journal / voucher / carbon
  dataType AuditLogDataType @map("data_type")
  // Info: (20260306 - Julian) 編輯的資料 journalId / voucherId / carbonId
  dataId   String           @map("data_id")

  // Info: (20260306 - Julian) 編輯資料所屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260306 - Julian) 編輯的動作 建立 / 更新 / 刪除
  action AuditLogAction @map("action")

  // Info: (20260306 - Julian) 編輯者的使用者
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// Info: (20260310 - Julian) 傳票
enum VoucherTradingType {
  INCOME
  OUTCOME
  TRANSFER
}

model Voucher {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Info: (20260310 - Julian) 交易日期
  tradingDate DateTime @map("trading_date")

  // Info: (20260310 - Julian) 交易類別: income, outcome, transfer
  tradingType VoucherTradingType? @map("trading_type")

  // Info: (20260310 - Julian) 備註
  note String? @db.Text

  // Info: (20260310 - Julian) 幣別
  currency String @default("TWD")

  // Info: (20260310 - Julian) 關聯檔案 (如附件)
  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  // Info: (20260310 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260310 - Julian) 開立此傳票的 User
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  // Info: (20260316 - Julian) AI 信心度
  confidence Int @map("confidence")

  // Info: (20260318 - Julian) 是否已經驗證
  isVerified Boolean @default(false) @map("is_verified")

  // Info: (20260318 - Julian) AI 分析狀態
  analysisStatus AIAnalysisStatus @default(PENDING) @map("analysis_status")

  // Info: (20260316 - Julian) 包含的分錄
  lines VoucherLine[]

  // Info: (20260324 - Julian) AI 分析的備註
  aiNote String @default("") @map("ai_note") @db.Text

  @@map("voucher")
}

// Info: (20260310 - Julian) 傳票分錄
model VoucherLine {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Info: (20260310 - Julian) 隸屬的傳票
  voucherId String  @map("voucher_id")
  voucher   Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)

  // Info: (20260310 - Julian) 會計項目代碼
  accountingCode String @map("accounting_code")

  // Info: (20260310 - Julian) 摘要
  particular String? @db.Text

  // Info: (20260310 - Julian) 金額
  amount Int

  // Info: (20260310 - Julian) 是否為借方 (true=借方/Debit, false=貸方/Credit)
  isDebit Boolean @map("is_debit")

  @@map("voucher_line")
}

// Info: (20260312 - Julian) ESG 分析紀錄
enum EsgScope {
  SCOPE_1
  SCOPE_2
  SCOPE_3
}

enum EsgIntensity {
  LOW
  MEDIUM
  HIGH
}

model EsgRecord {
  id                String           @id @default(uuid())
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  deletedAt         DateTime?        @map("deleted_at")
  tradingDate       DateTime         @map("trading_date") // Info: (20260407 - Julian) 交易日期
  scope             EsgScope? // Info: (20260312 - Julian) 範疇 (SCOPE_1, SCOPE_2, SCOPE_3)
  activityType      String           @map("activity_type") // Info: (20260312 - Julian) 活動類型
  vendor            String // Info: (20260312 - Julian) 供應商與對象
  amount            Decimal          @default(0) // Info: (20260416 - Julian) 活動數據
  unit              String // Info: (20260312 - Julian) 單位
  emissions         Decimal // Info: (20260312 - Julian) 排放量 (KGCO2E)
  intensity         EsgIntensity? // Info: (20260312 - Julian) 排放強度分類 (LOW, MEDIUM, HIGH)
  confidence        Int // Info: (20260312 - Julian) AI 信心度
  dqiScore          Decimal?         @map("dqi_score") // Info: (20260410 - Julian) DQI 數據品質指標
  isVerified        Boolean          @default(false) @map("is_verified") // Info: (20260318 - Julian) 是否已經驗證
  analysisStatus    AIAnalysisStatus @default(PENDING) @map("analysis_status") // Info: (20260318 - Julian) AI 分析狀態
  emissionSourceTag String?          @map("emission_source_tag") // Info: (20260421 - Julian) 排放源標籤（廠）

  // Info: (20260312 - Julian) 關聯檔案憑證
  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  // Info: (20260312 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260312 - Julian) 建立者
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  // Info: (20260416 - Julian) 關聯的碳排放係數
  coefficientId String?      @map("coefficient_id")
  coefficient   Coefficient? @relation(fields: [coefficientId], references: [id])

  // Info: (20260421 - Julian) 關聯的排放源
  emissionSourceId String?         @map("emission_source_id")
  emissionSource   EmissionSource? @relation(fields: [emissionSourceId], references: [id])

  // Info: (20260324 - Julian) AI 分析的備註
  aiNote String @default("") @map("ai_note") @db.Text

  @@map("esg_record")
}

// Info: (20260322 - Luphia) ESG 各年度目標
model EsgTarget {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Info: (20260322 - Luphia) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260322 - Luphia) 目標年份
  year Int

  // Info: (20260322 - Luphia) 總碳排放量目標
  totalEmissionTarget Decimal? @map("total_emission_target")

  // Info: (20260322 - Luphia) 每萬元營收排放量目標
  revenueEmissionTarget Decimal? @map("revenue_emission_target")

  @@unique([accountBookId, year])
  @@map("esg_target")
}

enum TaskType {
  FIN_REPORT // Info: (20260401 - Tzuhan) 財務年報 (PDF)
  FIN_DATA // Info: (20260408 - Tzuhan) 財務數據 (JSON)
  ESG_REPORT // Info: (20260401 - Tzuhan) 永續報告書 (PDF)
  ESG_METRICS // Info: (20260401 - Tzuhan) ESG 數據指標 (JSON)
}

enum TaskStatus {
  PENDING // Info: (20260401 - Tzuhan) 待下載
  SUCCESS // Info: (20260401 - Tzuhan) 下載成功
  FAILED // Info: (20260401 - Tzuhan) 下載失敗 (超過重試次數)
}

// Info: (20260402 - Tzuhan) twse 上市上櫃公司清單
model Company {
  stockId      String  @id @map("stock_id") // Info: (20260401 - Tzuhan) 公司代號 (如 "1101")
  name         String  @map("name") // Info: (20260401 - Tzuhan) 公司全稱
  abbreviation String? @map("abbreviation") // Info: (20260401 - Tzuhan) 公司簡稱 
  marketType   String  @map("market_type") // Info: (20260401 - Tzuhan) 市場別 ("sii" 或 "otc")
  isActive     Boolean @default(true) @map("is_active") // Info: (20260401 - Tzuhan) 是否持續追蹤 (可手動標記下市公司)

  // Info: (20260402 - Tzuhan) 穩定資訊 (便於未來搜尋、篩選與清洗)
  taxId             String? @map("tax_id") // Info: (20260402 - Tzuhan) 營利事業統一編號
  industry          String? @map("industry") // Info: (20260402 - Tzuhan) 產業別
  incorporationDate String? @map("incorporation_date") // Info: (20260402 - Tzuhan) 成立日期
  listingDate       String? @map("listing_date") // Info: (20260402 - Tzuhan) 上市/上櫃日期
  symbol            String? @map("symbol") // Info: (20260402 - Tzuhan) 英文簡稱

  // Info: (20260402 - Tzuhan) 其他不常用或易變動的資料
  metadata Json? @map("metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tasks ReportDownloadTask[]

  @@map("company")
}

model ReportDownloadTask {
  id          String @id @default(uuid())
  stockId     String @map("stock_id") // Info: (20260401 - Tzuhan) 公司代號 (如 "1101")
  companyName String @map("company_name") // Info: (20260401 - Tzuhan) 公司簡稱 (如 "台泥")
  marketType  String @map("market_type") // Info: (20260401 - Tzuhan) 市場別 ("sii" 或 "otc")
  year        Int    @map("year") // Info: (20260401 - Tzuhan) 目標年度 (如 2024)

  taskType TaskType   @map("task_type") // Info: (20260401 - Tzuhan) 任務類型
  status   TaskStatus @default(PENDING) // Info: (20260401 - Tzuhan) 初始建立時皆為 PENDING

  filePath   String? @map("file_path") // Info: (20260401 - Tzuhan) 檔案存放的相對路徑 (下載成功後寫入)
  retryCount Int     @default(0) @map("retry_count") // Info: (20260401 - Tzuhan) 重試次數
  errorMsg   String? @map("error_msg") @db.Text // Info: (20260401 - Tzuhan) 失敗時的錯誤訊息記錄

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [stockId], references: [stockId])

  // Info: (20260401 - Tzuhan) 複合唯一鍵：確保「同一家公司、同一年、同一種任務」絕對不會重複建立！
  @@unique([stockId, year, taskType])
  // Info: (20260401 - Tzuhan) 狀態索引：因為主控台會瘋狂 Query "PENDING" 的任務，加 Index 提升查詢速度
  @@index([status])
  @@map("report_download_task")
}

model Checkin {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  position  String?
  device    String?
  ip        String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("checkin")
}

model Coefficient {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  name           String
  description    String
  unit           String
  emissionFactor Decimal @map("emission_factor")
  source         String

  // Info: (20260413 - Julian) 關聯帳本，沒有帳本代表是標準係數
  accountBookId String?      @map("account_book_id")
  accountBook   AccountBook? @relation(fields: [accountBookId], references: [id])

  // Info: (20260416 - Julian) 關聯的 esg 紀錄
  esgRecords EsgRecord[]

  @@map("coefficient")
}

// Info: (20260410 - Tzuhan) 通用報告分享引擎，支援不同類型的報告對外分享
model ReportShareToken {
  id                    String   @id @default(uuid())
  token                 String   @unique @default(uuid()) // Info: (20260410 - Tzuhan) 實際暴露在 URL 的亂碼字串
  analysisId            String   @map("analysis_id")
  analysis              Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  category              String // Info: (20260410 - Tzuhan) 報告類別 (例如 carbon_health_check)，用於策略模式分流
  isActive              Boolean  @default(true) @map("is_active") // Info: (20260410 - Tzuhan) 支援手動關閉分享
  isFinancialDataHidden Boolean  @default(true) @map("is_financial_data_hidden") // Info: (20260416 - Tzuhan) 是否隱藏詳細財務數據
  createdById           String   @map("created_by_id")
  createdBy             User     @relation("ReportSharer", fields: [createdById], references: [id])

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  expiresAt DateTime? @map("expires_at") // Info: (20260410 - Tzuhan) 預留給未來「限時分享」功能使用

  @@index([token])
  @@index([analysisId])
  @@map("report_share_token")
}

// Info: (20260421 - Julian) 排放源
model EmissionSource {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  name    String // Info: (20260421 - Julian) 排放源名稱 (e.g., 公司貨車 ABC-1234) 
  address String? // Info: (20260421 - Julian) 廠區地址

  // ToDo: (20260421 - Julian) 之後會擴充更多欄位

  // Info: (20260421 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260421 - Julian) 關聯的碳盤查紀錄 (一對多)
  esgRecords EsgRecord[]

  @@map("emission_source")
}

// ==========================================================
// Info: (20260430 - Tzuhan) 基礎設施：全球港口節點 (支援 PostGIS)
// ==========================================================
model Seaport {
  id      String @id // Info: (20260430 - Tzuhan) 聯合國港口代碼 (UN/LOCODE, e.g., TWTPE)
  name    String // Info: (20260430 - Tzuhan) 港口名稱
  country String // Info: (20260430 - Tzuhan) 國家代碼
  size    String // Info: (20260430 - Tzuhan) 規模 (Large, Medium, Small)
  lat     Float
  lng     Float

  // Info: (20260430 - Tzuhan) PostGIS 專用的空間點位欄位，SRID 4326 代表 WGS84 經緯度座標系
  geom Unsupported("geometry(Point, 4326)")?

  source    String?
  sourceUrl String? @map("source_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([geom], type: Gist)
  @@map("seaports")
}

// ==========================================================
// Info: (20260430 - Tzuhan) 基礎設施：空運機場 (Airports)
// ==========================================================
model Airport {
  id       String                                @id // Info: (20260430 - Tzuhan) 機場內部代號或 ICAO (e.g., KLAX, 00A)
  iataCode String?                               @map("iata_code") // Info: (20260430 - Tzuhan) IATA 代碼 (e.g., TPE, LAX)，可能為空
  name     String // Info: (20260430 - Tzuhan) 機場名稱
  country  String // Info: (20260430 - Tzuhan) 國家代碼
  size     String // Info: (20260430 - Tzuhan) 規模 (large_airport, medium_airport, small_airport, heliport 等)
  lat      Float
  lng      Float
  geom     Unsupported("geometry(Point, 4326)")?

  source    String?
  sourceUrl String? @map("source_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([geom], type: Gist)
  @@index([iataCode])
  @@index([size])
  @@map("airports")
}

// ==========================================================
// Info: (20260430 - Tzuhan) 物流碳排引擎：快取機制 (Logistics Cache)
// ==========================================================
model LogisticsCache {
  id        String   @id @default(uuid())
  originLat Float    @map("origin_lat")
  originLng Float    @map("origin_lng")
  destLat   Float    @map("dest_lat")
  destLng   Float    @map("dest_lng")
  weightKg  Float    @map("weight_kg")
  
  // Info: (20260430 - Tzuhan) 將完整的 ILogisticsPlan (包含 GeoJSON) 快取起來
  planData  Json     @map("plan_data")
  
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Info: (20260430 - Tzuhan) 建立複合索引以加速查詢
  @@index([originLat, originLng, destLat, destLng, weightKg])
  @@map("logistics_cache")
}
