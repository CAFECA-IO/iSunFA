enum ReactionType {
  LIKE
  DISLIKE
}

// Info: (20260212 - Julian) 討論串的按讚
model Reaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260212 - Julian) 評價類型：是讚還是倒讚
