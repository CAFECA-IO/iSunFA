/**
 * Info: (20260812 - Julian) 離職的法律類型，與 `OffboardingProcess.reason`（個人原因）是兩個軸。
 * 原因是「為什麼走」，類型是「依什麼法律關係終止」。存下來的理由是後者會產生義務：
 * 資遣要算資遣費、要在離職 10 日前依就業服務法第 33 條列冊通報主管機關，
 * 而自請離職與定期契約期滿都沒有這兩件事。
 * 不存的話，「這個月有哪幾件要通報」就查不出來 —— 只能靠承辦人自己記得。
 */
enum ResignationType {
  VOLUNTARY // Info: (20260812 - Julian) 勞工自請離職
  LAYOFF // Info: (20260812 - Julian) 雇主資遣／解雇
  CONTRACT_END // Info: (20260812 - Julian) 定期契約期滿不續約
}

// Info: (20260810 - Julian) 新人報到流程檔
model OnboardingProcess {
  id         String   @id @default(uuid())
  employeeId String   @unique @map("employee_id") // Info: (20260810 - Julian) 一個員工對應一個報到流程
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  status      OnboardingStatus @default(NOT_STARTED)
  startDate   DateTime         @map("start_date") // Info: (20260810 - Julian) 預計/實際報到日
  completedAt DateTime?        @map("completed_at") // Info: (20260810 - Julian) 完成時間

  // Info: (20260810 - Julian) 關聯至細項任務
  tasks OnboardingTask[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@map("onboarding_process")
}

