/**
 * Info: (20260811 - Julian) 任務狀態為報到／離職兩張任務表共用。
 * 原本還有一個 `ProcessTaskType { ONBOARDING, OFFBOARDING }` 已移除 ——
 * 任務拆成兩張表之後，表名本身就是型別，那個欄位唯一能做的事是與實際掛的流程矛盾。
 * 詳見 `OnboardingTask` 的說明。
 */
enum ProcessTaskStatus {
  PENDING // Info: (20260810 - Julian) 待處理
  COMPLETED // Info: (20260810 - Julian) 已完成
