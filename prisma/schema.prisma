generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TeamRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model User {
  id String @id @default(uuid())

  // Info: (20260112 - Tzuhan) RWA Identity Contract (ONCHAINID)
  identityAddress String? @map("identity_address")

  //  Info: (20260112 - Tzuhan) 用戶的錢包 (address) 是這個 RWA Identity Contract 合約的 Owner
  address          String   @unique
  pubKeyX          String?  @map("pub_key_x")
  pubKeyY          String?  @map("pub_key_y")
  credentialId     String?  @unique @map("credential_id")
  currentChallenge String?  @map("current_challenge")
  name             String?
  imageUrl         String?  @map("image_url")
  kycData          Json?    @map("kyc_data")
  role             Role     @default(USER)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  orders                Order[]
  analyses              Analysis[]
  coefficients          Coefficient[]
  comments              Comment[]
  receivedReplies       Comment[]              @relation("CommentRecipient")
  reactions             Reaction[]
  paymentMethods        PaymentMethod[]
  paymentTransactions   PaymentTransaction[]
  journals              Journal[]
  teamMembers           TeamMember[]
  teamInvitations       TeamInvitation[]       @relation("Inviter")
  auditLogs             AuditLog[]
  vouchers              Voucher[]
  esgRecords            EsgRecord[]
  checkins              Checkin[]
  reportShareTokens     ReportShareToken[]     @relation("ReportSharer")
  campaignRegistrations CampaignRegistration[]
  coupons               Coupon[]
  pdfEditorDocuments    PdfEditorDocument[]    @relation("PdfEditorDocumentCreator")
  accountingAccounts    AccountingAccount[]
  teamWalletAllocations TeamWalletAllocation[]

  @@index([address])
  @@map("user")
}

model Team {
  id                    String                 @id @default(uuid())
  name                  String
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  deletedAt             DateTime?              @map("deleted_at")
  teamMembers           TeamMember[]
  teamInvitations       TeamInvitation[]
  accountBooks          AccountBook[]
  teamSubscription      TeamSubscription?
  teamWallet            TeamWallet?
  teamWalletAllocations TeamWalletAllocation[]
  teamQuotaUsages       TeamQuotaUsage[]

  @@map("team")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  role      TeamRole
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@map("team_member")
}

model TeamInvitation {
  id             String   @id @default(uuid())
  teamId         String   @map("team_id")
  team           Team     @relation(fields: [teamId], references: [id])
  inviterId      String   @map("inviter_id")
  inviter        User     @relation("Inviter", fields: [inviterId], references: [id])
  inviteeAddress String   @map("invitee_address")
  role           TeamRole
  status         String   @default("PENDING") // Info: (20260325 - Tzuhan) PENDING, ACCEPTED, REJECTED
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("team_invitation")
}

/**
 * Info: (20260807 - Luphia)
 * 團隊錢包與訂閱額度（設計書 documents/architecture/team_wallet_and_subscription_quota.md、ADR 015）。
 * 團隊點數採離鏈決定論帳本（C 案混合制：離鏈營運 + 每日 merkle 鏈上錨定），
 * 金額一律 BigInt 零誤差；TeamWalletLedger 為 append-only，更正僅允許反向分錄。
 */
model TeamSubscription {
  id                 String   @id @default(uuid())
  teamId             String   @unique @map("team_id")
  team               Team     @relation(fields: [teamId], references: [id])
  planId             String   @default("free") @map("plan_id") // Info: (20260807 - Luphia) PLAN 常數 (free/team/business)
  status             String   @default("ACTIVE") // Info: (20260807 - Luphia) TEAM_SUBSCRIPTION_STATUS 常數
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  autoRenew          Boolean  @default(true) @map("auto_renew")
  latestOrderId      String?  @map("latest_order_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("team_subscription")
}

model TeamWallet {
  id                 String             @id @default(uuid())
  teamId             String             @unique @map("team_id")
  team               Team               @relation(fields: [teamId], references: [id])
  unallocatedBalance BigInt             @default(0) @map("unallocated_balance")
  status             String             @default("ACTIVE") // Info: (20260807 - Luphia) TEAM_WALLET_STATUS: ACTIVE / FROZEN / CLOSED
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  ledgers            TeamWalletLedger[]

  @@map("team_wallet")
}

model TeamWalletAllocation {
  id        String   @id @default(uuid())
  teamId    String   @map("team_id")
  team      Team     @relation(fields: [teamId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  balance   BigInt   @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([teamId, userId])
  @@map("team_wallet_allocation")
}

model TeamWalletLedger {
  id                     String     @id @default(uuid())
  teamWalletId           String     @map("team_wallet_id")
  teamWallet             TeamWallet @relation(fields: [teamWalletId], references: [id])
  entryType              String     @map("entry_type") // Info: (20260807 - Luphia) TEAM_WALLET_ENTRY_TYPE 常數
  amount                 BigInt // Info: (20260807 - Luphia) 有號數：入帳為正、出帳為負
  poolBalanceAfter       BigInt?    @map("pool_balance_after")
  allocationBalanceAfter BigInt?    @map("allocation_balance_after")
  targetUserId           String?    @map("target_user_id")
  operatorUserId         String     @map("operator_user_id")
  orderId                String?    @map("order_id")
  featureCode            String?    @map("feature_code") // Info: (20260807 - Luphia) BILLABLE_FEATURE_CODE 常數
  idempotencyKey         String     @unique @map("idempotency_key")
  createdAt              DateTime   @default(now()) @map("created_at")

  @@index([teamWalletId, createdAt])
  @@map("team_wallet_ledger")
}

model TeamQuotaUsage {
  id             String   @id @default(uuid())
  teamId         String   @map("team_id")
  team           Team     @relation(fields: [teamId], references: [id])
  userId         String   @map("user_id")
  featureCode    String   @map("feature_code")
  amount         BigInt
  windowKey5h    Int      @map("window_key_5h")
  windowKeyWeek  Int      @map("window_key_week")
  // Info: (20260807 - Luphia) 冪等鍵：重試不重複扣額度；退款列以 refund: 前綴共用同一鍵空間
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([teamId, windowKey5h])
  @@index([teamId, windowKeyWeek])
  @@map("team_quota_usage")
}

/**
 * Info: (20260809 - Luphia) 訂閱方案額度：系統設定值，由 DB 保存而非環境變數。
 * 額度屬營運設定（可由後台調整、需變更軌跡、多實例一致），非部署環境差異；
 * 且 env 於 client bundle 讀不到，會造成 SSR 與水合結果不一致。
 * 查無方案設定列時，以 src/constants/subscription_quota.ts 的預設值 fail-safe。
 */
model SubscriptionPlanQuota {
  id        String   @id @default(uuid())
  planId    String   @unique @map("plan_id") // Info: (20260809 - Luphia) PLAN 常數 (free/team/business)
  per5h     Int      @map("per_5h")
  perWeek   Int      @map("per_week")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription_plan_quota")
}

/**
 * Info: (20260809 - Luphia) 費思計費設定：系統設定值，由 DB 保存而非環境變數（同 SubscriptionPlanQuota）。
 * 單列設定（singleton），以固定主鍵 "default" 保證唯一。
 * 查無設定列時，以 src/constants/llm.ts 的 DEFAULT_FAITH_BILLING fail-safe。
 */
model FaithBillingSetting {
  key                     String   @id @default("default")
  tokensPerCredit         Int      @map("tokens_per_credit")
  maxOutputTokens         Int      @map("max_output_tokens")
  imageInputTokenEstimate Int      @map("image_input_token_estimate")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("faith_billing_setting")
}

model TeamLedgerAnchor {
  id            String   @id @default(uuid())
  anchorDate    DateTime @unique @map("anchor_date") // Info: (20260807 - Luphia) 錨定的營業日（UTC+8 日界）
  entryCount    Int      @map("entry_count")
  dayMerkleRoot String   @map("day_merkle_root")
  chainedRoot   String   @map("chained_root") // Info: (20260807 - Luphia) keccak256(前日 chainedRoot ‖ dayMerkleRoot)
  txHash        String?  @map("tx_hash")
  status        String   @default("PENDING") // Info: (20260807 - Luphia) TEAM_LEDGER_ANCHOR_STATUS 常數
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("team_ledger_anchor")
}

model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  type            String
  amount          BigInt
  unit            String   @default("ICP")
  data            Json
  status          String   @default("PENDING")
  challenge       String
  signature       String?
  transactionHash String?  @map("transaction_hash")
  mission         String?
  tokens          Int?     @default(0)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  analysis            Analysis[]
  paymentTransactions PaymentTransaction[]
  receipt             Receipt?

  @@map("order")
}

// Info: (20260128 - Luphia) Analysis 直接將 data 與 result 放在 mission 裡面
model Analysis {
  id      String @id
  userId  String @map("user_id")
  user    User   @relation(fields: [userId], references: [id])
  orderId String @map("order_id")
  order   Order  @relation(fields: [orderId], references: [id])
  type    String
  data    Json
  result  Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags              AnalysisTag[]
  reportShareTokens ReportShareToken[]
  files             File[]
  comments          Comment[]
  reactions         Reaction[]

  @@map("analysis")
}

// Info: (20260226 - Julian) 上傳檔案：儲存 hash
model File {
  id       String  @id @default(uuid())
  hash     String
  fileName String? @map("file_name")

  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  analysisId String?   @map("analysis_id")

  journals   Journal[]
  vouchers   Voucher[]
  esgRecords EsgRecord[]
  employeeDocument EmployeeDocument[]

  @@map("file")
}

// Info: (20260212 - Julian) 評論：支援巢狀回覆
model Comment {
  id         String   @id @default(uuid())
  content    String   @db.Text
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  analysisId String   @map("analysis_id")
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  // Info: (20260212 - Julian) 巢狀邏輯
  parentCommentId String?   @map("parent_comment_id")
  parentComment   Comment?  @relation("ReplyTo", fields: [parentCommentId], references: [id])
  replies         Comment[] @relation("ReplyTo")

  // Info: (20260212 - Julian) 回覆對象
  replyToUserId String? @map("reply_to_user_id")
  replyToUser   User?   @relation("CommentRecipient", fields: [replyToUserId], references: [id])

  createdAt      DateTime   @default(now()) @map("created_at")
  deletedAt      DateTime?  @map("deleted_at")
  isProfessional Boolean    @default(false) @map("is_professional")
  reactions      Reaction[]

  @@map("comment")
}

// Info: (20260212 - Julian) 討論串標籤
model Tag {
  id       String        @id @default(uuid())
  name     String        @unique
  analyses AnalysisTag[]

  @@map("tag")
}

enum ReactionType {
  LIKE
  DISLIKE
}

// Info: (20260212 - Julian) 討論串的按讚
model Reaction {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260212 - Julian) 評價類型：是讚還是倒讚
  type ReactionType

  // Info: (20260212 - Julian) 關聯使用者
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  // Info: (20260212 - Julian) 關聯分析/對話
  analysisId String?   @map("analysis_id")
  analysis   Analysis? @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  // Info: (20260212 - Julian) 關聯評論
  commentId String?  @map("comment_id")
  comment   Comment? @relation(fields: [commentId], references: [id])

  // Info: (20260212 - Julian) 核心約束：一個使用者對同一個物件只能有一個評價
  @@unique([userId, analysisId])
  @@unique([userId, commentId])
  @@map("reaction")
}

// Info: (20260311 - Tzuhan) Analysis - Tags
model AnalysisTag {
  analysisId String   @map("analysis_id")
  analysis   Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  tagId      String   @map("tag_id")
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@id([analysisId, tagId])
  @@map("analysis_tag")
}

model PaymentMethod {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  provider  String
  token     String
  data      Json?
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  transactions PaymentTransaction[]

  @@map("payment_method")
}

// Info: (20260302 - Tzuhan) 獨立的 PaymentTransaction Table，減少支付模組的耦合性
model PaymentTransaction {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id])
  paymentMethodId String?        @map("payment_method_id")
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  orderId         String?        @map("order_id")
  order           Order?         @relation(fields: [orderId], references: [id])
  provider        String
  amount          BigInt
  status          String         @default("PENDING") // Info: (20260302 - Tzuhan) PENDING, SUCCESS, FAILED
  errorMessage    String?        @map("error_message")
  rawData         Json?          @map("raw_data")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("payment_transaction")
}

model Receipt {
  id        String   @id @default(uuid())
  orderId   String   @unique @map("order_id")
  order     Order    @relation(fields: [orderId], references: [id])
  amount    BigInt
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("receipt")
}

enum AIAnalysisStatus {
  PENDING // Info: (20260318 - Julian) 尚未開始
  PROCESSING // Info: (20260318 - Julian) 正在處理
  COMPLETED // Info: (20260318 - Julian) 已完成
  FAILED // Info: (20260318 - Julian) 失敗
}

// Info: (20260304 - Julian) 憑證/日記帳
model Journal {
  id             String           @id @default(uuid())
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  text           String           @db.Text // Info: (20260304 - Julian) AI 辨識出的文字結果
  analysisStatus AIAnalysisStatus @default(PENDING) @map("analysis_status")
  tradingDate    DateTime         @default(now()) @map("trading_date")
  confidence     Int              @default(0) @map("confidence")
  isVerified     Boolean          @default(false) @map("is_verified")
  aiNote         String           @map("ai_note") @db.Text // Info: (20260325 - Julian) AI 分析的備註

  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  // Info: (20260305 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])
  user          User?       @relation(fields: [userId], references: [id])
  userId        String?

  deletedAt DateTime? @map("deleted_at")

  @@map("journal")
}

// Info: (20260305 - Julian) 帳本
model AccountBook {
  id            String    @id @default(uuid())
  name          String
  country       String
  currency      String
  rule          String
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")
  enterpriseId  String?   @map("enterprise_id")
  esgIndustryId Int?      @map("esg_industry_id")

  // Info: (20260306 - Luphia) 帳本所屬的團隊
  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id])

  // Info: (20260508 - Tzuhan) 面額 (預設 10)
  parValue Float @default(10) @map("par_value")

  // Info: (20260716 - Tzuhan) #52 帳本的碳盤查會話(報告/狀態經 chatroom 綁定)
  chatrooms Chatroom[]

  // Info: (20260305 - Julian) 一個帳本可以有多個憑證
  journals Journal[]

  // Info: (20260310 - Julian) 一個帳本可以有多個傳票
  vouchers Voucher[]

  // Info: (20260306 - Julian) 一個帳本可以有多個編輯紀錄
  auditLogs AuditLog[]

  // Info: (20260312 - Julian) 帳本對應的 ESG 紀錄
  esgRecords EsgRecord[]

  // Info: (20260322 - Luphia) 帳本對應的各年度 ESG 目標
  esgTargets EsgTarget[]

  // Info: (20260413 - Julian) 帳本對應的係數
  coefficients Coefficient[]

  // Info: (20260421 - Julian) 帳本對應的排放源
  emissionSources EmissionSource[]

  // Info: (20260513 - Luphia) 帳本對應的數位產品護照 SKU
  digitalProductPassportSkus DigitalProductPassportSku[]

  // Info: (20260703 - Julian) 帳本對應的客製化會計科目
  accountingAccounts AccountingAccount[]

  // Info: (20260811 - Julian) 帳本對應的人資 (HR) 資料
  departments          Department[]
  jobTitles            JobTitle[]
  employees            Employee[]
  employeeEducations   EmployeeEducation[]
  employeeExperiences  EmployeeExperience[]
  emergencyContacts    EmergencyContact[]
  dependents           Dependent[]
  bankAccounts         BankAccount[]
  processTasks         ProcessTask[]
  onboardingProcesses  OnboardingProcess[]
  probationReviews     ProbationReview[]
  offboardingProcesses OffboardingProcess[]
  employeeDocuments    EmployeeDocument[]

  @@map("account_book")
}

// Info: (20260306 - Julian) 資料編輯 log
enum AuditLogDataType {
  JOURNAL
  VOUCHER
  ESG_RECORD
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

model AuditLog {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260306 - Julian) 編輯的資料類型 journal / voucher / carbon
  dataType AuditLogDataType @map("data_type")
  // Info: (20260306 - Julian) 編輯的資料 journalId / voucherId / carbonId
  dataId   String           @map("data_id")

  // Info: (20260306 - Julian) 編輯資料所屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260306 - Julian) 編輯的動作 建立 / 更新 / 刪除
  action AuditLogAction @map("action")

  // Info: (20260306 - Julian) 編輯者的使用者
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("audit_log")
}

// Info: (20260310 - Julian) 傳票
enum VoucherTradingType {
  INCOME
  OUTCOME
  TRANSFER
}

model Voucher {
  id        String    @id @default(uuid())
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Info: (20260310 - Julian) 交易日期
  tradingDate DateTime @map("trading_date")

  // Info: (20260310 - Julian) 交易類別: income, outcome, transfer
  tradingType VoucherTradingType? @map("trading_type")

  // Info: (20260310 - Julian) 備註
  note String? @db.Text

  // Info: (20260522 - Tzuhan) 廠商統編 (用於發票與收據之一般稅務紀錄，已廢除 O(1) 靜態攔截)
  vendorTaxId String? @map("vendor_tax_id")

  // Info: (20260310 - Julian) 幣別
  currency String @default("TWD")

  // Info: (20260310 - Julian) 關聯檔案 (如附件)
  fileId String? @map("file_id")
  file   File?   @relation(fields: [fileId], references: [id])

  // Info: (20260310 - Julian) 隸屬的帳本
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260310 - Julian) 開立此傳票的 User
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  // Info: (20260316 - Julian) AI 信心度
  confidence Int @map("confidence")

  // Info: (20260318 - Julian) 是否已經驗證
  isVerified Boolean @default(false) @map("is_verified")

  // Info: (20260318 - Julian) AI 分析狀態
  analysisStatus AIAnalysisStatus @default(PENDING) @map("analysis_status")

  // Info: (20260316 - Julian) 包含的分錄
  lines VoucherLine[]

  // Info: (20260324 - Julian) AI 分析的備註
  aiNote String @default("") @map("ai_note") @db.Text

  paymentStatus      String    @default("NOT_APPLICABLE") @map("payment_status")
  clearedByVoucherId String?   @map("cleared_by_voucher_id")
