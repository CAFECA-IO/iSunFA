  result  Json?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tags              AnalysisTag[]
  reportShareTokens ReportShareToken[]
  files             File[]
  comments          Comment[]
  reactions         Reaction[]

  @@map("analysis")
}

