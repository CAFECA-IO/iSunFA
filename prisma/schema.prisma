  anchorDate    DateTime @unique @map("anchor_date") // Info: (20260807 - Luphia) 錨定的營業日（UTC+8 日界）
  entryCount    Int      @map("entry_count")
  dayMerkleRoot String   @map("day_merkle_root")
  chainedRoot   String   @map("chained_root") // Info: (20260807 - Luphia) keccak256(前日 chainedRoot ‖ dayMerkleRoot)
  txHash        String?  @map("tx_hash")
