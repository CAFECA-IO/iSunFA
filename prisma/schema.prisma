// Info: (20260810 - Julian) 離職申請與退保流程檔
model OffboardingProcess {
  id             String            @id @default(uuid())
  employeeId     String            @unique @map("employee_id")
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  status         OffboardingStatus @default(PENDING)

  reason         String?           // Info: (20260810 - Julian) 離職原因
  /**
   * Info: (20260812 - Julian) 離職類型。可為 null 是給既有資料留的空間，不是它可以不填。
   *
   * ToDo: (20260812 - Julian) 既有紀錄回填後應改為必填 —— 一筆不知道是自請還是資遣的
   * 離職紀錄，在資遣費與通報這兩件事上都答不出「該不該做」。
   */
  resignationType ResignationType? @map("resignation_type")
  expectedDate   DateTime          @map("expected_date") // Info: (20260810 - Julian) 預計離職日
  actualDate     DateTime?         @map("actual_date") // Info: (20260810 - Julian) 實際離職日
  insuranceOffAt DateTime?         @map("insurance_off_at") // Info: (20260810 - Julian) 勞健保退保生效日

  /**
   * ToDo: (20260812 - Julian) 資遣費相關欄位待補（平均工資、基數、實付金額、發給日）。
   *
   * 平均工資要讀離職前六個月的實際薪資，而 schema 裡沒有薪資表。
   * 決策、待決事項與薪資模組要提供的介面見
   * `documents/architecture/decisions/020_severance_pay_estimation.md`。
   */

  // Info: (20260810 - Julian) 關聯至交接細項任務
  tasks          OffboardingTask[]

  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

