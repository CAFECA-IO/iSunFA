// Info: (20260810 - Julian) 合約與文件管理 (Documents & Contracts)
model EmployeeDocument {
  id          String           @id @default(uuid())
  employeeId  String           @map("employee_id")
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  title       String           // Info: (20260810 - Julian) 文件名稱 (例: 2026 勞動契約)
  category    DocumentCategory // Info: (20260810 - Julian) 文件分類
