  inventoryState CarbonInventoryState?
  reportDraft    CarbonReportDraft?
  pendingImport  CarbonPendingImport?

  // Info: (20260714 - Tzuhan) 供「依擁有者列出聊天室」的 sessions 查詢
  @@index([ownerPublicKey])
  @@index([accountBookId])
  @@map("chatroom")
}

// Info: (20260714 - Tzuhan) 碳盤查報告草稿(E2EE at rest,仿 ChatroomMessage 封裝):每 chatroom 一筆,version 樂觀鎖
// Info: (20260714 - Tzuhan) 僅存密文;前端以主公鑰(xpub)加密上傳、以 PRF 解鎖之主私鑰解密,server 無法解讀內容
model CarbonReportDraft {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260714 - Tzuhan) base64(iv + 密文):IReportData 的序列化密文
  // Info: (20260716 - Tzuhan) #52 帳本模式(模型 A)改存 plainContent,envelope 欄位轉 optional(舊個人資料相容)
  encryptedContent String? @map("encrypted_content") @db.Text

  // Info: (20260716 - Tzuhan) #52 帳本模式明文(伺服器端 at-rest 加密由 DB 層承擔,對齊 Journal/Voucher 信任等級)
  plainContent String? @map("plain_content") @db.Text

  // Info: (20260714 - Tzuhan) ECIES 臨時公鑰與 HD 派生線索(同 ChatroomMessage 欄位語意)
  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  // Info: (20260714 - Tzuhan) 加密對象(用戶主公鑰)
  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260714 - Tzuhan) 樂觀鎖:PUT 需帶讀取時的版本,不符即拒絕(防雙分頁 silent overwrite)
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_report_draft")
}

/**
 * Info: (20260806 - Tzuhan) 待匯入的解析結果(E2EE at rest,封裝比照 CarbonReportDraft):每 chatroom 一筆。
 *
 * 解析一份 64 頁報告要跑十幾次 LLM、好幾分鐘。原本結果只存在 React state ——
 * 重整、切帳號、瀏覽器當掉,幾分鐘的解析就沒了,而使用者唯一能做的是重新上傳再等一次。
 * 而且「當下先不匯入」根本無法表達:不當場按套用,結果就消失。
 *
 * 這裡存的是**尚未寫進報告**的內容,與 CarbonReportDraft 是不同生命週期的兩份資料:
 * 套用或捨棄時刪除,在那之前一直在。不共用同一筆紀錄的理由就是這個 ——
 * 混在一起會分不清「已落地的報告」與「等待人工確認的候選」,
 * 而人工確認那道 gate 正是這個模組的核心設計。
 */
model CarbonPendingImport {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260806 - Tzuhan) base64(iv + 密文):待匯入內容(含各段原文、活動數據、cid)的序列化密文
  encryptedContent String? @map("encrypted_content") @db.Text

  // Info: (20260806 - Tzuhan) 帳本模式明文(at-rest 加密由 DB 層承擔,同 CarbonReportDraft 的雙模式)
  plainContent String? @map("plain_content") @db.Text

  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260806 - Tzuhan) 樂觀鎖:PUT 需帶讀取時的版本,不符即拒(防雙分頁互相覆蓋)
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_pending_import")
}

// Info: (20260712 - Luphia) 碳盤查結構化事實狀態（方案 A：伺服器端明文 Jsonb，供組 prompt／勾稽／報告）
// Info: (20260712 - Luphia) 敏感事實；存取限伺服器端，未來可依需求升級為加密（設計文件方案 B/C）
model CarbonInventoryState {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260716 - Tzuhan) #6518 改密文 envelope(比照 CarbonReportDraft):
  // Info: (20260716 - Tzuhan) 原明文 state Json 違反本模組 E2EE 慣例;table 無資料,無遷移負擔
  // Info: (20260716 - Tzuhan) #52 帳本模式改存 plainContent,envelope 欄位轉 optional
  encryptedContent String? @map("encrypted_content") @db.Text

  plainContent String? @map("plain_content") @db.Text

  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260712 - Luphia) 樂觀鎖／稽核用版本號
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_inventory_state")
}

// Info: (20260712 - Luphia) 聊天室訊息紀錄；所有通過的訊息皆入庫，且僅保存密文與回推解密金鑰所需的線索
model ChatroomMessage {
  id String @id @default(uuid())

  chatroomId String   @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260712 - Luphia) 寄件者公鑰（可為匿名/選填）與收件者公鑰（加密對象）
  senderPublicKey    String? @map("sender_public_key")
  recipientPublicKey String  @map("recipient_public_key")

  // Info: (20260712 - Luphia) 僅保存密文（AES-GCM 封裝於 ECIES），不存明文
  encryptedContent String @map("encrypted_content") @db.Text

  // Info: (20260712 - Luphia) ECIES 臨時公鑰，供收件者以主私鑰做 ECDH 還原對稱金鑰
  ephemeralPublicKey String? @map("ephemeral_public_key")

  // Info: (20260712 - Luphia) 加解密演算法標記（版本化，便於未來演進）
  algorithm String @default("ECIES-secp256k1-AES-256-GCM")

  // Info: (20260712 - Luphia) 加密私鑰的「線索」：HD 派生路徑/索引（類 hdwallet），供持主私鑰者回推對應解密金鑰
  keyDerivationHint String @map("key_derivation_hint")

  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260714 - Tzuhan) 複合索引對齊 history 分頁查詢(chatroomId + createdAt desc 取代單欄索引)
  @@index([chatroomId, createdAt])
  @@index([recipientPublicKey])
  @@map("chatroom_message")
}

// Info: (20260712 - Luphia) 用戶加密金鑰：公鑰對外公開供他人加密；主私鑰以 passkey PRF 派生金鑰包裝後僅存密文
model UserEncryptionKey {
  id String @id @default(uuid())

  // Info: (20260712 - Luphia) 用戶身分（錢包 address，對應 User.address）
  userAddress String @unique @map("user_address")

  // Info: (20260712 - Luphia) 對外公開的加密主公鑰（供他人以 ECIES 加密給此用戶）
  encryptionPublicKey String @map("encryption_public_key")

  /**
   * Info: (20260712 - Luphia) 以 passkey PRF 派生金鑰包裝後的主私鑰（僅密文入庫，伺服器無法解開）
   *
   * Info: (20260812 - Luphia) 「伺服器無法解開」**只對 passkey 列成立**。
   * 託管帳號（第三方登入）的包裝金鑰由伺服器以保險庫主密鑰派生（見 ADR 016 補充），
   * 那些列平台有能力解開。哪一種請看 `algorithm` —— 它就是為此而存在。
   */
  wrappedPrivateKey String @map("wrapped_private_key") @db.Text

  // Info: (20260712 - Luphia) PRF 派生所需的 salt（類 hdwallet 的線索之一，供回推包裝金鑰）
  prfSalt String @map("prf_salt")

  /**
   * Info: (20260712 - Luphia) 包裝/派生演算法標記（版本化）
   *
   * Info: (20260812 - Luphia) 值域見 `src/constants/chatroom_key.ts`：
   * passkey 列為 `WebAuthnPRF-…`（即此處的預設值，既有列都靠它寫入，不可更動），
   * 託管列為 `CustodialPRF-v1-…`。解包前會比對它與當下的 custody，
   * 不一致即拒絕解包並要求金鑰移轉 —— 否則 custody 翻轉會靜默毀掉那些對話。
   */
  algorithm String @default("WebAuthnPRF-HKDF-AES-256-GCM")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_encryption_key")
}

// Info: (20260716 - Tzuhan) 每使用者附件儲存用量(#6517):配額檢查 O(1) 讀;bytes 用 BigInt(精度規範)
model UserStorageUsage {
  id        Int      @id @default(autoincrement())
  address   String   @unique
  usedBytes BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_storage_usage")
}

/**
 * Info: (20260811 - Julian) ========== 人事模組個資保護等級（本區塊 13 張表的預設值）==========
 *
 * ## 決策
 *
 * 敏感個資欄位一律以**應用層欄位加密**入庫（AES-256-GCM，金鑰由伺服器持有），
 * 對外預設回遮罩值，取用完整值另走一條路徑並寫 `AuditLog`。
 * 完整脈絡見 `documents/architecture/decisions/018_hr_pii_data_classification.md`。
 *
 * ## 為什麼不是 E2EE（碳盤查的做法）
 *
 * `ChatroomMessage` / `CarbonReportDraft` 那套 ECIES envelope 之所以成立，是因為
 * 那些資料**只有使用者自己要讀**；伺服器讀不到不影響任何功能。
 * 人事資料相反：薪轉檔產製、勞健保申報、離職退保、試用期到期通知，
 * 全部是背景 Worker 在跑。金鑰若只在前端，這些流程永遠解不開資料 ——
 * E2EE 會廢掉這個模組一半的功能，也與 CLAUDE.md §7「計算收斂到後端確定性規則引擎」衝突。
 *
 * 所以這裡取的是中間值：**伺服器讀得到，資料庫本身讀不到**。
 * 防的是 DB dump、備份外洩、DBA 越權直讀、誤上傳的還原檔 ——
 * 這些正是個資外洩事故的實際大宗。防不了的是應用層被攻破，那由 §存取稽核 補。
 *
 * ## 為什麼不是「維持明文，靠 DB 層 at-rest 加密」
 *
 * `sovereign_cloud_security_drp.md` 宣告的 PostgreSQL AES-256 靜態加密是**磁碟層**的，
 * 對 `pg_dump`、對持有連線字串的人、對備份檔完全無效 —— 它防的是實體磁碟被搬走。
 * 帳本模式的 `CarbonReportDraft.plainContent` 接受這個等級，理由是那是碳排活動數據；
 * 而這裡存的是身分證字號與銀行帳號，外洩後果是身分冒用與金流盜用，不是同一個量級。
 * 保護強度不該低於它所保護的東西。
 *
 * ## 落地規則
 *
 * 1. 密文欄位一律以 `Cipher` 結尾（`nationalIdCipher`、`accountNumberCipher`…）。
 *    命名就是型別以外的第二道提醒：看到 `Cipher` 就知道這不是能直接顯示的值。
 * 2. 每張持有個資的表帶 `piiAlgorithm` + `piiKeyVersion`，支援金鑰輪替時新舊並存。
 * 3. `piiKeyVersion` 在密文欄位全為選填的表（Dependent）可為 null；
 *    其餘三張表至少有一個必填密文欄位，因此改為 NOT NULL 由資料庫直接擋
 *    （見各表欄位上的說明）。不變式仍然保留：它涵蓋 Dependent，
 *    也涵蓋「沒有任何密文卻標了代次」的反方向。
 *    原文保留於此以說明規則本身：**任一密文欄位有值時它必須有值** ——
 *    比照 `carbon_envelope_invariant.ts` 的「寫得進去就必須讀得出來」，
 *    由 `src/repositories/hr_pii_invariant.ts` 擋在寫入端，而不是讀取端。
 * 4. 未加密的欄位是刻意的，理由逐欄記在 ADR 018：
 *    `employeeNo` / `email` 要進複合唯一鍵，`name` 要排序與模糊搜尋，
 *    加密會讓這兩件事都做不到，而它們單獨不足以冒用身分。
 * 5. `birthday` 加密後失去 DB 端的日期查詢能力。目前沒有任何查詢用到它；
 *    未來若需要「本月壽星」這類需求，加一個非敏感的衍生欄位（如 `birthMonth Int?`），
 *    不要為了查詢把 `birthday` 改回明文。
 */
// Info: (20260810 - Julian) 員工基本資料
enum EmployeeStatus {
  ACTIVE             // Info: (20260810 - Julian) 在職
  PROBATION          // Info: (20260810 - Julian) 試用期
  LEAVE_WITHOUT_PAY  // Info: (20260810 - Julian) 留職停薪
  RESIGNED           // Info: (20260810 - Julian) 離職
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Info: (20260810 - Julian) 公司部門 (支援無限層級樹狀圖)
model Department {
  id          String       @id @default(uuid())
  code        String       // Info: (20260810 - Julian) 部門編號 (例: DEP-001)，唯一性以帳本為範圍
  name        String       // Info: (20260810 - Julian) 部門名稱
  description String?

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260810 - Julian) 樹狀圖自關聯 (父部門與子部門)
  parentId    String?      @map("parent_id")
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentTree")

  // Info: (20260810 - Julian) 部門最高主管 (簽核流程節點之一)
  managerId   String?      @unique @map("manager_id")
  manager     Employee?    @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)

  employees   Employee[]   @relation("DeptEmployees")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@index([parentId])
  @@map("department")
}

// Info: (20260810 - Julian) 職稱字典
model JobTitle {
  id          String     @id @default(uuid())
  code        String     // Info: (20260810 - Julian) 職稱代號 (例: JT-DEV-LEAD)，唯一性以帳本為範圍
  title       String     // Info: (20260810 - Julian) 職稱名稱 (例: 前端工程師)
  level       Int        @default(1) // Info: (20260810 - Julian) 職等/職級 (可用於差旅標準或簽核門檻判斷)
  description String?

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  employees   Employee[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@map("job_title")
}

// Info: (20260810 - Julian) 員工基本資料
model Employee {
  id            String         @id @default(uuid())
  employeeNo    String         @map("employee_no") // Info: (20260810 - Julian) 工號 (例: EMP001)，唯一性以帳本為範圍
  name          String         // Info: (20260810 - Julian) 姓名
  englishName   String?        @map("english_name") // Info: (20260810 - Julian) 英文名
  gender        Gender
  email         String         // Info: (20260810 - Julian) 公司 Email，唯一性以帳本為範圍；為複合唯一鍵成員，不加密
  status        EmployeeStatus @default(PROBATION)
  hireDate      DateTime       @map("hire_date") // Info: (20260810 - Julian) 到職日
  leaveDate     DateTime?      @map("leave_date") // Info: (20260810 - Julian) 離職日

  /**
   * Info: (20260813 - Julian) 綁定的系統帳號。
   *
   * 員工要能自己打卡、查自己的班表與出勤，就必須能從登入身分找回員工檔 ——
   * 而登入身分是 `User`（Google 登入或 passkey），出勤事實掛在 `Employee`。
   *
   * 可空：員工檔可能先由 HR 建立、本人尚未登入過。
   * `@unique`：一個系統帳號只能對應一位員工。
   *
   * 首次綁定以 `UserIdentity.email` 比對本表的 `email`（公司信箱）。
   * **那只是引導，綁定本身是這個欄位** —— 公司信箱可以變更（改名、部門調動），
   * 而打卡歷史不該跟著飄移；且 `personalEmailCipher` 是密文、DB 端查不了，
   * 用個人信箱登入的人本來就對不上（ADR 018 §7 已知取捨第 2 條的必然結果）。
   */
  userId String? @unique @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Info: (20260811 - Julian) --- 敏感個資（密文入庫，見本區塊開頭的決策說明）---
  // Info: (20260811 - Julian) Tier 1 受限：身分證字號 / 護照號碼，可直接用於冒用身分；讀取完整值需寫 AuditLog
  nationalIdCipher String? @map("national_id_cipher")
  /**
   * Info: (20260811 - Julian) 盲索引 (blind index)：HMAC-SHA256(pepper, 正規化後的身分證字號)。
   *
   * AES-GCM 每次用隨機 IV，同一個身分證字號兩次加密不會得到同一段密文 ——
   * 唯一約束掛不上密文，但「同一帳本不得重複建檔同一人」這條規則不該因為加密而消失。
   * 因此另存一個決定性摘要專供唯一性比對，明文仍只在 `nationalIdCipher`。
   *
   * 用 HMAC 而不是裸 SHA-256：台灣身分證字號的空間只有約 2.4 億組，
   * 裸雜湊被 dump 出去等於幾分鐘就能反查完。pepper 由伺服器持有且不入庫，
   * 拿到 DB 的人沒有 pepper 就無法枚舉。
   */
  nationalIdHash String? @map("national_id_hash")
  // Info: (20260811 - Julian) Tier 2 機密：生日以 ISO-8601 字串加密（型別由 DateTime 轉 String 是加密的必然代價）
  birthdayCipher   String? @map("birthday_cipher")
  // Info: (20260811 - Julian) Tier 2 機密：通訊地址
  addressCipher    String? @map("address_cipher")
  // Info: (20260811 - Julian) Tier 2 機密：聯絡電話（原為必填，加密後維持必填）
  phoneCipher      String  @map("phone_cipher")
  /**
   * Info: (20260812 - Julian) Tier 2 機密：個人信箱（非公司信箱）。
   *
   * 與 `email` 分成兩欄而不是共用一欄：公司信箱是複合唯一鍵成員、
   * 全公司通訊錄都看得到，且隨離職一併停用；個人信箱是一輩子跟著人走的
   * 識別碼，離職後仍然有效 —— 兩者的敏感度差一個級別，不該同欄。
   *
   * 可為 null：只有走「發起新人報到」且勾選寄送預填表單的人才有值。
   *
   * ## 它的用途在離職後才最重要
   *
   * 報到前那段「還沒有公司帳號」的空窗期只是最先想到的場景。真正撐起
   * 這一欄的是離職之後 —— 那時公司信箱已停用，但公司仍然有事要找人：
   * 隔年才寄的扣繳憑單、隨時可能被請求補發的服務證明書（勞基法第 19 條
   * 對此沒有時效）、遞延獎酬與競業補償金的給付、事後才發現的薪資差額，
   * 以及回聘。用「報到完成」當清除時點會剛好清在它開始有用的那一天。
   *
   * ToDo: (20260812 - Julian) 保存期限錨在 `leaveDate` 而不是
   * `OnboardingProcess.completedAt`：離職滿 N 年後由排程清空。
   * N 暫以 5 年為準（比照勞基法第 7 條勞工名卡的保存年限），但要注意
   * **個人信箱並不在勞工名卡的法定欄位裡** —— 那是類比，不是依據，
   * 實際年限需法務確認。個資法要求特定目的消失或期限屆滿即應刪除，
   * 所以這條排程不是選配：沒有它，這一欄就是一個沒有終點的個資。
   *
   * ToDo: (20260812 - Julian) 保存到離職後，就必須同時答得出
   * 「這個信箱當初依什麼特定目的、什麼時候蒐集的」。那是一筆同意紀錄，
   * 不是 `Employee` 上再加一欄 —— 需要另開一張表或掛在 OnboardingProcess 上。
   */
  personalEmailCipher String? @map("personal_email_cipher")

  // Info: (20260811 - Julian) 個資封裝參數：演算法版本化，keyVersion 供金鑰輪替時新舊並存
  // Info: (20260811 - Julian) keyVersion 可為 null（整列無密文時），但任一密文有值即必須有值，由 hr_pii_invariant 擋在寫入端
  piiAlgorithm  String  @default("AES-256-GCM") @map("pii_algorithm")
  // Info: (20260812 - Luphia) 非空:本表至少有一個密文欄位是必填的,所以代次必然存在。
  // Info: (20260812 - Luphia) 由資料庫擋而不是只靠 assertStorablePii —— 那條不變式點名的威脅
  // Info: (20260812 - Luphia) 是「繞過 service 的呼叫(種子腳本、資料遷移、金鑰輪替作業)」,
  // Info: (20260812 - Luphia) 而用 raw SQL 的輪替腳本同樣繞過 TS 守衛,只有 NOT NULL 攔得住。
  piiKeyVersion Int    @map("pii_key_version")

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260810 - Julian) 部門與職稱關聯
  departmentId  String?        @map("department_id")
  department    Department?    @relation("DeptEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitleId    String?        @map("job_title_id")
  jobTitle      JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)

  // Info: (20260810 - Julian) 直屬主管關係 (Self-Relation，假勤流程直屬主管簽核的核心)
  managerId     String?        @map("manager_id")
  manager       Employee?      @relation("ManagerSubordinate", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]     @relation("ManagerSubordinate")

  // Info: (20260810 - Julian) 反向關聯：被設定為部門主管
  managedDepartment Department? @relation("DeptManager")

  // Info: (20260810 - Julian) 子資料表關聯
  educations    EmployeeEducation[]
  experiences   EmployeeExperience[]
  contacts      EmergencyContact[]
  dependents    Dependent[]
  bankAccounts  BankAccount[]
  onboardingProcess   OnboardingProcess?
  probationReview     ProbationReview?
  offboardingProcess  OffboardingProcess?
  documents           EmployeeDocument[]
  conductedReviews    ProbationReview[]    @relation("ProbationReviewer")
  // Info: (20260811 - Julian) 被指派的任務拆成兩份：「我的待辦」需查兩張表再合併，是拆表換取型別保證的代價
  assignedOnboardingTasks  OnboardingTask[]  @relation("OnboardingTaskAssignee")
  assignedOffboardingTasks OffboardingTask[] @relation("OffboardingTaskAssignee")

  // Info: (20260813 - Julian) 簽到系統：排班與打卡紀錄
  shiftDays         EmployeeShiftDay[]
  attendancePunches AttendancePunch[]

  // Info: (20260813 - Julian) 假勤：自己的假單、以核准者身分做過的決定、以主管身分發起的銷假徵詢
  leaveRequests  LeaveRequest[] @relation("LeaveRequestEmployee")
  leaveDecisions LeaveRequest[] @relation("LeaveRequestDecider")
  leaveRecalls   LeaveRecall[]  @relation("LeaveRecallRequester")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([accountBookId, employeeNo])
  @@unique([accountBookId, email])
  // Info: (20260811 - Julian) 身分證的帳本內唯一改掛盲索引，不是取消 —— 理由見 nationalIdHash 欄位註解
  @@unique([accountBookId, nationalIdHash])
  @@index([accountBookId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([managerId])
  @@map("employee")
}

// Info: (20260810 - Julian) ========== 員工詳細資料 ==========
// Info: (20260810 - Julian) 學歷資料
model EmployeeEducation {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  schoolName  String    @map("school_name") // Info: (20260810 - Julian) 學校名稱
  major       String?   // Info: (20260810 - Julian) 科系/專業
  degree      String    // Info: (20260810 - Julian) 學位 (如: 學士、碩士)
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")
  isGraduated Boolean   @default(true) @map("is_graduated")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("employee_education")
}

// Info: (20260810 - Julian) 工作經歷
model EmployeeExperience {
  id          String    @id @default(uuid())
  employeeId  String    @map("employee_id")
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  companyName String    @map("company_name") // Info: (20260810 - Julian) 公司名稱
  position    String    // Info: (20260810 - Julian) 當時職位
  description String?   // Info: (20260810 - Julian) 主要職責/成就
  startDate   DateTime  @map("start_date")
  endDate     DateTime? @map("end_date")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("employee_experience")
}

// Info: (20260810 - Julian) 緊急聯絡人
model EmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String   @map("employee_id")
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  name         String   // Info: (20260810 - Julian) 聯絡人姓名
  relationship String   // Info: (20260810 - Julian) 關係 (例: 配偶、父母)
  isPrimary    Boolean  @default(false) @map("is_primary") // Info: (20260810 - Julian) 是否為第一順位聯絡人

  // Info: (20260811 - Julian) --- 敏感個資（密文入庫，見本區塊開頭的決策說明）---
  // Info: (20260811 - Julian) Tier 2 機密：緊急聯絡人電話。與眷屬同理，聯絡人是未同意過條款的第三人，
  // Info: (20260811 - Julian) 且這份名單本身就是「員工的私人關係網」，外洩即可用於社交工程
  phoneCipher    String  @map("phone_cipher")
  altPhoneCipher String? @map("alt_phone_cipher")

  // Info: (20260811 - Julian) 個資封裝參數，語意同 Employee
  piiAlgorithm  String @default("AES-256-GCM") @map("pii_algorithm")
  // Info: (20260812 - Luphia) 非空:本表至少有一個密文欄位是必填的,所以代次必然存在。
  // Info: (20260812 - Luphia) 由資料庫擋而不是只靠 assertStorablePii —— 那條不變式點名的威脅
  // Info: (20260812 - Luphia) 是「繞過 service 的呼叫(種子腳本、資料遷移、金鑰輪替作業)」,
  // Info: (20260812 - Luphia) 而用 raw SQL 的輪替腳本同樣繞過 TS 守衛,只有 NOT NULL 攔得住。
  piiKeyVersion Int   @map("pii_key_version")

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("emergency_contact")
}

// Info: (20260810 - Julian) 眷屬資料 (健保投保 / 報稅扶養)
model Dependent {
  id                    String    @id @default(uuid())
  employeeId            String    @map("employee_id")
  employee              Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  name                  String    // Info: (20260810 - Julian) 眷屬姓名
  relationship          String    // Info: (20260810 - Julian) 關係
  isNationalHealthInsur Boolean   @default(true) @map("is_national_health_insur") // Info: (20260810 - Julian) 是否隨同參加健保

  // Info: (20260811 - Julian) --- 敏感個資（密文入庫，見本區塊開頭的決策說明）---
  // Info: (20260811 - Julian) Tier 1 受限：眷屬身分證字號。眷屬並非本系統使用者、從未同意過任何條款，
  // Info: (20260811 - Julian) 保護等級只能高於員工本人，不能低於；不設盲索引，眷屬本就可能重複掛在不同員工下（如夫妻同公司）
  nationalIdCipher String? @map("national_id_cipher")
  // Info: (20260811 - Julian) Tier 2 機密：眷屬生日（ISO-8601 字串）。與 Employee.birthday 同級，不因為是眷屬就降級
  birthdayCipher   String? @map("birthday_cipher")

  // Info: (20260811 - Julian) 個資封裝參數，語意同 Employee
  piiAlgorithm  String @default("AES-256-GCM") @map("pii_algorithm")
  piiKeyVersion Int?   @map("pii_key_version")

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("dependent")
}

// Info: (20260810 - Julian) 薪轉銀行帳戶
model BankAccount {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260811 - Julian) 銀行/分行代碼與名稱維持明文：那是公開的金融機構字典值，不是個資
  bankCode      String   @map("bank_code") // Info: (20260810 - Julian) 銀行代碼 (例: 822)
  bankName      String   @map("bank_name") // Info: (20260810 - Julian) 銀行名稱 (例: 中國信託)
  branchCode    String?  @map("branch_code") // Info: (20260810 - Julian) 分行代碼
  branchName    String?  @map("branch_name") // Info: (20260810 - Julian) 分行名稱
  isPrimary     Boolean  @default(true) @map("is_primary") // Info: (20260810 - Julian) 是否為主薪轉帳戶

  // Info: (20260811 - Julian) --- 敏感個資（密文入庫，見本區塊開頭的決策說明）---
  // Info: (20260811 - Julian) Tier 1 受限：帳戶號碼與戶名。這兩個湊齊即可直接用於金流盜用，
  // Info: (20260811 - Julian) 是本模組風險最高的一組欄位；讀取完整值需寫 AuditLog
  accountNumberCipher String @map("account_number_cipher")
  accountHolderCipher String @map("account_holder_cipher")

  // Info: (20260811 - Julian) 個資封裝參數，語意同 Employee
  piiAlgorithm  String @default("AES-256-GCM") @map("pii_algorithm")
  // Info: (20260812 - Luphia) 非空:本表至少有一個密文欄位是必填的,所以代次必然存在。
  // Info: (20260812 - Luphia) 由資料庫擋而不是只靠 assertStorablePii —— 那條不變式點名的威脅
  // Info: (20260812 - Luphia) 是「繞過 service 的呼叫(種子腳本、資料遷移、金鑰輪替作業)」,
  // Info: (20260812 - Luphia) 而用 raw SQL 的輪替腳本同樣繞過 TS 守衛,只有 NOT NULL 攔得住。
  piiKeyVersion Int   @map("pii_key_version")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("bank_account")
}

enum OnboardingStatus {
  NOT_STARTED // Info: (20260810 - Julian) 未開始
  IN_PROGRESS // Info: (20260810 - Julian) 進行中
  COMPLETED   // Info: (20260810 - Julian) 已完成
  CANCELLED   // Info: (20260810 - Julian) 已取消
}

enum OffboardingStatus {
  PENDING     // Info: (20260810 - Julian) 待處理
  IN_PROGRESS // Info: (20260810 - Julian) 交接中
  COMPLETED   // Info: (20260810 - Julian) 已完成
  REJECTED    // Info: (20260810 - Julian) 駁回
}

/**
 * Info: (20260811 - Julian) 任務狀態為報到／離職兩張任務表共用。
 *
 * 原本還有一個 `ProcessTaskType { ONBOARDING, OFFBOARDING }` 已移除 ——
 * 任務拆成兩張表之後，表名本身就是型別，那個欄位唯一能做的事是與實際掛的流程矛盾。
 * 詳見 `OnboardingTask` 的說明。
 */
enum ProcessTaskStatus {
  PENDING     // Info: (20260810 - Julian) 待處理
  COMPLETED   // Info: (20260810 - Julian) 已完成
  SKIPPED     // Info: (20260810 - Julian) 跳過
}

/**
 * Info: (20260811 - Julian) 試用期考核結果。
 *
 * 原本是 `String?`，而註解裡自己列舉了這三個值 —— 註解列得出來的封閉集合就是 enum，
 * 用 String 只是把「有哪些合法值」這件事從型別系統搬到人腦裡（CLAUDE.md §3 拒絕魔法字串）。
 *
 * 這三個值都會進 if/switch：EXTEND 要延長試用期並重排考核日，
 * FAIL 要觸發離職流程，PASS 要把 `EmployeeStatus` 從 PROBATION 轉成 ACTIVE。
 * 用 String 的話，一個 "Pass" 大小寫之差就會讓員工卡在試用期而沒有任何錯誤。
 *
 * 對照組：`relationship`（眷屬／緊急聯絡人關係）維持 String 是對的 ——
 * 那是自由文字，使用者可以填「岳母」「同居人」，不進任何判斷。
 * 判準不是「看起來像不像列舉」，是「有沒有程式碼拿它做分支」。
 */
enum ProbationResult {
  PASS   // Info: (20260811 - Julian) 通過，轉正職
  EXTEND // Info: (20260811 - Julian) 延長試用期
  FAIL   // Info: (20260811 - Julian) 未通過
}

enum DocumentCategory {
  CONTRACT    // Info: (20260810 - Julian) 勞動契約
  NDA         // Info: (20260810 - Julian) 保密協定
  CERTIFICATE // Info: (20260810 - Julian) 證照圖檔
  OTHER       // Info: (20260810 - Julian) 其他
}

/**
 * Info: (20260811 - Julian) 報到任務清單 (Task Checklist)。
 *
 * ## 為什麼是兩張表，不是一張帶 taskType 的 ProcessTask
 *
 * 原本的單表設計把兩個外鍵都設成可選（`onboardingProcessId?` / `offboardingProcessId?`），
 * 沒有任何機制保證恰有一個。這讓三種非法狀態都寫得進去：
 *
 * 1. **兩個都掛** —— 一個任務同時屬於某人的報到流程與另一人的離職流程。
 * 2. **都不掛** —— 孤兒任務，不會出現在任何清單裡，也沒有人會發現它存在。
 * 3. **taskType 與實際流程矛盾** —— `taskType: ONBOARDING` 卻掛在 `offboardingProcessId` 上。
 *    這種紀錄在「報到進度」與「離職交接進度」兩張畫面上會各自呈現不同的真相。
 *
 * Prisma 的 schema DSL 沒有 CHECK 約束，單表要擋只能靠執行期檢查 ——
 * 而執行期檢查擋不住繞過 service 的寫入（種子腳本、資料遷移、批次匯入）。
 *
 * 拆表之後外鍵轉為**必填**，三種狀態在型別層就無法表示，一行檢查都不用寫。
 * `taskType` 一併移除：表名即型別，那個欄位唯一能做的事就是說謊。
 *
 * 這與碳盤查那條「一個寫得進去就再也讀不出來的狀態，不該是可達的」是同一個判準，
 * 只是這裡有更強的解 —— 碳盤查的 envelope 無法用型別表達，只能用不變式擋在寫入端；
 * 這裡可以直接讓非法狀態不存在。**能讓它不可表示，就不要退而求其次讓它可被拒絕。**
 *
 * ## 代價
 *
 * 兩張表的欄位目前完全相同，等於複製一份定義。接受這個重複，理由有二：
 * 一是重複的是 7 個欄位、不是邏輯；二是兩種任務未來大概率會分化 ——
 * 離職交接需要「交接對象」與「資產歸還確認」，報到不需要，屆時單表會被迫再加一批可選欄位。
 *
 * 「我的待辦」這類跨兩種任務的查詢需要查兩張表再合併。這是拆表唯一的實質成本。
 */
model OnboardingTask {
  id          String            @id @default(uuid())
  title       String            // Info: (20260810 - Julian) 任務名稱 (例: 發放門禁卡、環境設定、勞健保加保)
  description String?
  status      ProcessTaskStatus @default(PENDING)
  /**
   * Info: (20260812 - Julian) 這一列是由哪一條範本產生的（例：`ONBOARDING_LAPTOP`）。
   *
   * 不是給人看的標籤，是程式用來分類的鍵值：報到列表的「表單 / 設備 / 契約」
   * 三欄各自看一組 key，離職的資產回收表與三項退保也是。沒有這一欄，
   * 分類只能回頭比對 `title` 字串 —— 那會在有人改一個字、或換一種語言時整片失效。
   *
   * 可為 null：手動新增的臨時任務不屬於任何範本。
   *
   * ToDo: (20260812 - Julian) 目前值域由前端的 `OnboardingTaskKey` / `OffboardingTaskKey`
   * 約定，DB 端不約束。範本改成可由使用者維護時，這裡要改成指向範本表的外鍵。
   */
  templateKey String?           @map("template_key")

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260811 - Julian) 歸屬的報到流程。必填 —— 這正是拆表要換到的東西，孤兒任務不可表示
  onboardingProcessId String            @map("onboarding_process_id")
  onboardingProcess   OnboardingProcess @relation(fields: [onboardingProcessId], references: [id], onDelete: Cascade)

  // Info: (20260810 - Julian) 負責處理該任務的人 (例: IT 部門人員、HR)
  assigneeId  String?   @map("assignee_id")
  assignee    Employee? @relation("OnboardingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([onboardingProcessId])
  @@index([assigneeId])
  @@map("onboarding_task")
}

// Info: (20260811 - Julian) 離職交接任務清單。拆表理由見 OnboardingTask 的說明，兩張表對稱
model OffboardingTask {
  id          String            @id @default(uuid())
  title       String            // Info: (20260810 - Julian) 任務名稱 (例: 收回電腦、繳回門禁卡、勞健保退保)
  description String?
  status      ProcessTaskStatus @default(PENDING)
  // Info: (20260812 - Julian) 範本鍵值（例：`OFFBOARDING_LAPTOP_RETURN`），語意與限制同 OnboardingTask.templateKey
  templateKey String?           @map("template_key")

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260811 - Julian) 歸屬的離職流程。必填，同 OnboardingTask
  offboardingProcessId String             @map("offboarding_process_id")
  offboardingProcess   OffboardingProcess @relation(fields: [offboardingProcessId], references: [id], onDelete: Cascade)

  // Info: (20260810 - Julian) 負責處理該任務的人 (例: IT 部門人員、HR)
  assigneeId  String?   @map("assignee_id")
  assignee    Employee? @relation("OffboardingTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt DateTime? @map("completed_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([offboardingProcessId])
  @@index([assigneeId])
  @@map("offboarding_task")
}

/**
 * Info: (20260812 - Julian) 離職的法律類型，與 `OffboardingProcess.reason`（個人原因）是兩個軸。
 *
 * 原因是「為什麼走」，類型是「依什麼法律關係終止」。存下來的理由是後者會產生義務：
 * 資遣要算資遣費、要在離職 10 日前依就業服務法第 33 條列冊通報主管機關，
 * 而自請離職與定期契約期滿都沒有這兩件事。
 *
 * 不存的話，「這個月有哪幾件要通報」就查不出來 —— 只能靠承辦人自己記得。
 */
enum ResignationType {
  VOLUNTARY    // Info: (20260812 - Julian) 勞工自請離職
  LAYOFF       // Info: (20260812 - Julian) 雇主資遣／解雇
  CONTRACT_END // Info: (20260812 - Julian) 定期契約期滿不續約
}

// Info: (20260810 - Julian) 新人報到流程檔
model OnboardingProcess {
  id           String           @id @default(uuid())
  employeeId   String           @unique @map("employee_id") // Info: (20260810 - Julian) 一個員工對應一個報到流程
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  status       OnboardingStatus @default(NOT_STARTED)
  startDate    DateTime         @map("start_date") // Info: (20260810 - Julian) 預計/實際報到日
  completedAt  DateTime?        @map("completed_at") // Info: (20260810 - Julian) 完成時間

  // Info: (20260810 - Julian) 關聯至細項任務
  tasks        OnboardingTask[]

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@map("onboarding_process")
}

// Info: (20260810 - Julian) 試用期考核紀錄
model ProbationReview {
