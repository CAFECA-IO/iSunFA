  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  reviewerId   String?   @map("reviewer_id") // Info: (20260810 - Julian) 考核主管 ID
  reviewer     Employee? @relation("ProbationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewDate   DateTime?        @map("review_date") // Info: (20260810 - Julian) 考核日期
  score        Int?             // Info: (20260810 - Julian) 評分 (例: 1-100)
  comment      String?          // Info: (20260810 - Julian) 考核評語
  // Info: (20260811 - Julian) 尚未考核時為 null；已考核則必為三個列舉值之一
