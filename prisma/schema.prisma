  date DateTime

  // Info: (20260514 - Tzuhan) 雙幣別設計 (A幣 換 B幣)
  baseCurrency   String @map("base_currency") // 基準本位幣 (例如: "TWD")
  targetCurrency String @map("target_currency") // 目標外幣 (例如: "KRW", "USD", "EUR")

