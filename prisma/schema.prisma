// Info: (20260712 - Luphia) 加密聊天室；以公鑰定址，任何人可加密訊息給指定對象
model Chatroom {
  id String @id @default(uuid())

  // Info: (20260716 - Tzuhan) #52 碳盤查報告歸屬帳本(模型 A):null = 個人會話(相容舊資料)
  accountBookId String?      @map("account_book_id")
  accountBook   AccountBook? @relation(fields: [accountBookId], references: [id])

  // Info: (20260712 - Luphia) 頻道識別（如 carbon-chat-{address}-{session}）
  channel String @unique

  // Info: (20260712 - Luphia) 用途分類（如 carbon_chatbot），供不同用途區隔
  purpose String?

  // Info: (20260712 - Luphia) 建立者/擁有者的公鑰（非內部 FK，維持公鑰定址）
  ownerPublicKey String? @map("owner_public_key")

  // Info: (20260730 - Tzuhan) 封存時間(軟刪):null = 使用中。清單預設排除已封存者,但資料仍在且可還原。
  // Info: (20260730 - Tzuhan) 刻意不做硬刪:一個會話連帶整份 33 節報告與活動數據帳本,
  // Info: (20260730 - Tzuhan) 在審計系統裡誤刪一份已查核的報告是不可逆的損失。硬刪需求另議(需二次確認 + 稽核軌跡)。
  archivedAt DateTime? @map("archived_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages       ChatroomMessage[]
  inventoryState CarbonInventoryState?
  reportDraft    CarbonReportDraft?
  pendingImport  CarbonPendingImport?

  // Info: (20260714 - Tzuhan) 供「依擁有者列出聊天室」的 sessions 查詢
  @@index([ownerPublicKey])
  @@index([accountBookId])
  @@map("chatroom")
}

// Info: (20260714 - Tzuhan) 碳盤查報告草稿(E2EE at rest,仿 ChatroomMessage 封裝):每 chatroom 一筆,version 樂觀鎖
// Info: (20260714 - Tzuhan) 僅存密文;前端以主公鑰(xpub)加密上傳、以 PRF 解鎖之主私鑰解密,server 無法解讀內容
model CarbonReportDraft {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260714 - Tzuhan) base64(iv + 密文):IReportData 的序列化密文
  // Info: (20260716 - Tzuhan) #52 帳本模式(模型 A)改存 plainContent,envelope 欄位轉 optional(舊個人資料相容)
  encryptedContent String? @map("encrypted_content") @db.Text

  // Info: (20260716 - Tzuhan) #52 帳本模式明文(伺服器端 at-rest 加密由 DB 層承擔,對齊 Journal/Voucher 信任等級)
  plainContent String? @map("plain_content") @db.Text

  // Info: (20260714 - Tzuhan) ECIES 臨時公鑰與 HD 派生線索(同 ChatroomMessage 欄位語意)
  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  // Info: (20260714 - Tzuhan) 加密對象(用戶主公鑰)
  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260714 - Tzuhan) 樂觀鎖:PUT 需帶讀取時的版本,不符即拒絕(防雙分頁 silent overwrite)
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_report_draft")
}

/**
 * Info: (20260806 - Tzuhan) 待匯入的解析結果(E2EE at rest,封裝比照 CarbonReportDraft):每 chatroom 一筆。
 *
 * 解析一份 64 頁報告要跑十幾次 LLM、好幾分鐘。原本結果只存在 React state ——
 * 重整、切帳號、瀏覽器當掉,幾分鐘的解析就沒了,而使用者唯一能做的是重新上傳再等一次。
 * 而且「當下先不匯入」根本無法表達:不當場按套用,結果就消失。
 *
 * 這裡存的是**尚未寫進報告**的內容,與 CarbonReportDraft 是不同生命週期的兩份資料:
 * 套用或捨棄時刪除,在那之前一直在。不共用同一筆紀錄的理由就是這個 ——
 * 混在一起會分不清「已落地的報告」與「等待人工確認的候選」,
 * 而人工確認那道 gate 正是這個模組的核心設計。
 */
model CarbonPendingImport {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260806 - Tzuhan) base64(iv + 密文):待匯入內容(含各段原文、活動數據、cid)的序列化密文
  encryptedContent String? @map("encrypted_content") @db.Text

  // Info: (20260806 - Tzuhan) 帳本模式明文(at-rest 加密由 DB 層承擔,同 CarbonReportDraft 的雙模式)
  plainContent String? @map("plain_content") @db.Text

  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260806 - Tzuhan) 樂觀鎖:PUT 需帶讀取時的版本,不符即拒(防雙分頁互相覆蓋)
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_pending_import")
}

// Info: (20260712 - Luphia) 碳盤查結構化事實狀態（方案 A：伺服器端明文 Jsonb，供組 prompt／勾稽／報告）
// Info: (20260712 - Luphia) 敏感事實；存取限伺服器端，未來可依需求升級為加密（設計文件方案 B/C）
model CarbonInventoryState {
  id String @id @default(uuid())

  chatroomId String   @unique @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260716 - Tzuhan) #6518 改密文 envelope(比照 CarbonReportDraft):
  // Info: (20260716 - Tzuhan) 原明文 state Json 違反本模組 E2EE 慣例;table 無資料,無遷移負擔
  // Info: (20260716 - Tzuhan) #52 帳本模式改存 plainContent,envelope 欄位轉 optional
  encryptedContent String? @map("encrypted_content") @db.Text

  plainContent String? @map("plain_content") @db.Text

  ephemeralPublicKey String? @map("ephemeral_public_key")
  keyDerivationHint  String? @map("key_derivation_hint")
  algorithm          String  @default("ECIES-secp256k1-AES-256-GCM")

  recipientPublicKey String @map("recipient_public_key")

  // Info: (20260712 - Luphia) 樂觀鎖／稽核用版本號
  version Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("carbon_inventory_state")
}

// Info: (20260712 - Luphia) 聊天室訊息紀錄；所有通過的訊息皆入庫，且僅保存密文與回推解密金鑰所需的線索
model ChatroomMessage {
  id String @id @default(uuid())

  chatroomId String   @map("chatroom_id")
  chatroom   Chatroom @relation(fields: [chatroomId], references: [id])

  // Info: (20260712 - Luphia) 寄件者公鑰（可為匿名/選填）與收件者公鑰（加密對象）
  senderPublicKey    String? @map("sender_public_key")
  recipientPublicKey String  @map("recipient_public_key")

  // Info: (20260712 - Luphia) 僅保存密文（AES-GCM 封裝於 ECIES），不存明文
  encryptedContent String @map("encrypted_content") @db.Text

  // Info: (20260712 - Luphia) ECIES 臨時公鑰，供收件者以主私鑰做 ECDH 還原對稱金鑰
  ephemeralPublicKey String? @map("ephemeral_public_key")

  // Info: (20260712 - Luphia) 加解密演算法標記（版本化，便於未來演進）
  algorithm String @default("ECIES-secp256k1-AES-256-GCM")

  // Info: (20260712 - Luphia) 加密私鑰的「線索」：HD 派生路徑/索引（類 hdwallet），供持主私鑰者回推對應解密金鑰
  keyDerivationHint String @map("key_derivation_hint")

  createdAt DateTime @default(now()) @map("created_at")

  // Info: (20260714 - Tzuhan) 複合索引對齊 history 分頁查詢(chatroomId + createdAt desc 取代單欄索引)
  @@index([chatroomId, createdAt])
  @@index([recipientPublicKey])
  @@map("chatroom_message")
}

// Info: (20260712 - Luphia) 用戶加密金鑰：公鑰對外公開供他人加密；主私鑰以 passkey PRF 派生金鑰包裝後僅存密文
model UserEncryptionKey {
  id String @id @default(uuid())

  // Info: (20260712 - Luphia) 用戶身分（錢包 address，對應 User.address）
  userAddress String @unique @map("user_address")

  // Info: (20260712 - Luphia) 對外公開的加密主公鑰（供他人以 ECIES 加密給此用戶）
  encryptionPublicKey String @map("encryption_public_key")

  // Info: (20260712 - Luphia) 以 passkey PRF 派生金鑰包裝後的主私鑰（僅密文入庫，伺服器無法解開）
  wrappedPrivateKey String @map("wrapped_private_key") @db.Text

  // Info: (20260712 - Luphia) PRF 派生所需的 salt（類 hdwallet 的線索之一，供回推包裝金鑰）
  prfSalt String @map("prf_salt")

  // Info: (20260712 - Luphia) 包裝/派生演算法標記（版本化）
  algorithm String @default("WebAuthnPRF-HKDF-AES-256-GCM")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("user_encryption_key")
}

// Info: (20260716 - Tzuhan) 每使用者附件儲存用量(#6517):配額檢查 O(1) 讀;bytes 用 BigInt(精度規範)
model UserStorageUsage {
  id        Int      @id @default(autoincrement())
  address   String   @unique
  usedBytes BigInt   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_storage_usage")
}

// Info: (20260810 - Julian) 員工基本資料
enum EmployeeStatus {
  ACTIVE             // Info: (20260810 - Julian) 在職
  PROBATION          // Info: (20260810 - Julian) 試用期
  LEAVE_WITHOUT_PAY  // Info: (20260810 - Julian) 留職停薪
  RESIGNED           // Info: (20260810 - Julian) 離職
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// Info: (20260810 - Julian) 公司部門 (支援無限層級樹狀圖)
model Department {
  id          String       @id @default(uuid())
  code        String       // Info: (20260810 - Julian) 部門編號 (例: DEP-001)，唯一性以帳本為範圍
  name        String       // Info: (20260810 - Julian) 部門名稱
  description String?

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260810 - Julian) 樹狀圖自關聯 (父部門與子部門)
  parentId    String?      @map("parent_id")
  parent      Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Department[] @relation("DepartmentTree")

  // Info: (20260810 - Julian) 部門最高主管 (簽核流程節點之一)
  managerId   String?      @unique @map("manager_id")
  manager     Employee?    @relation("DeptManager", fields: [managerId], references: [id], onDelete: SetNull)

  employees   Employee[]   @relation("DeptEmployees")

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@index([parentId])
  @@map("department")
}

// Info: (20260810 - Julian) 職稱字典
model JobTitle {
  id          String     @id @default(uuid())
  code        String     // Info: (20260810 - Julian) 職稱代號 (例: JT-DEV-LEAD)，唯一性以帳本為範圍
  title       String     // Info: (20260810 - Julian) 職稱名稱 (例: 前端工程師)
  level       Int        @default(1) // Info: (20260810 - Julian) 職等/職級 (可用於差旅標準或簽核門檻判斷)
  description String?

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  employees   Employee[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@map("job_title")
}

// Info: (20260810 - Julian) 員工基本資料
model Employee {
  id            String         @id @default(uuid())
  employeeNo    String         @map("employee_no") // Info: (20260810 - Julian) 工號 (例: EMP001)，唯一性以帳本為範圍
  name          String         // Info: (20260810 - Julian) 姓名
  englishName   String?        @map("english_name") // Info: (20260810 - Julian) 英文名
  gender        Gender
  birthday      DateTime?
  nationalId    String?        @map("national_id") // Info: (20260810 - Julian) 身分證字號 / 護照號碼
  email         String         // Info: (20260810 - Julian) 公司 Email，唯一性以帳本為範圍
  phone         String         // Info: (20260810 - Julian) 聯絡電話
  address       String?        // Info: (20260810 - Julian) 通訊地址
  status        EmployeeStatus @default(PROBATION)
  hireDate      DateTime       @map("hire_date") // Info: (20260810 - Julian) 到職日
  leaveDate     DateTime?      @map("leave_date") // Info: (20260810 - Julian) 離職日

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260810 - Julian) 部門與職稱關聯
  departmentId  String?        @map("department_id")
  department    Department?    @relation("DeptEmployees", fields: [departmentId], references: [id], onDelete: SetNull)
  jobTitleId    String?        @map("job_title_id")
  jobTitle      JobTitle?      @relation(fields: [jobTitleId], references: [id], onDelete: SetNull)

  // Info: (20260810 - Julian) 直屬主管關係 (Self-Relation，假勤流程直屬主管簽核的核心)
  managerId     String?        @map("manager_id")
  manager       Employee?      @relation("ManagerSubordinate", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates  Employee[]     @relation("ManagerSubordinate")

  // Info: (20260810 - Julian) 反向關聯：被設定為部門主管
  managedDepartment Department? @relation("DeptManager")

  // Info: (20260810 - Julian) 子資料表關聯
  educations    EmployeeEducation[]
  experiences   EmployeeExperience[]
  contacts      EmergencyContact[]
  dependents    Dependent[]
  bankAccounts  BankAccount[]
  onboardingProcess   OnboardingProcess?
  probationReview     ProbationReview?
  offboardingProcess  OffboardingProcess?
  documents           EmployeeDocument[]
  assignedTasks       ProcessTask[]        @relation("TaskAssignee")
  conductedReviews    ProbationReview[]    @relation("ProbationReviewer")

  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([accountBookId, employeeNo])
  @@unique([accountBookId, email])
  @@unique([accountBookId, nationalId])
  @@index([accountBookId])
  @@index([departmentId])
  @@index([jobTitleId])
  @@index([managerId])
  @@map("employee")
}

// Info: (20260810 - Julian) ========== 員工詳細資料 ==========
