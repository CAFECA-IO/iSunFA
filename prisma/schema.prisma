// Info: (20260810 - Julian) 薪轉銀行帳戶
model BankAccount {
  id            String   @id @default(uuid())
  employeeId    String   @map("employee_id")
  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  bankCode      String   @map("bank_code") // Info: (20260810 - Julian) 銀行代碼 (例: 822)
  bankName      String   @map("bank_name") // Info: (20260810 - Julian) 銀行名稱 (例: 中國信託)
  branchCode    String?  @map("branch_code") // Info: (20260810 - Julian) 分行代碼
  branchName    String?  @map("branch_name") // Info: (20260810 - Julian) 分行名稱
  accountNumber String   @map("account_number") // Info: (20260810 - Julian) 帳戶號碼
  accountHolder String   @map("account_holder") // Info: (20260810 - Julian) 戶名
  isPrimary     Boolean  @default(true) @map("is_primary") // Info: (20260810 - Julian) 是否為主薪轉帳戶

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("bank_account")
}

enum OnboardingStatus {
  NOT_STARTED // Info: (20260810 - Julian) 未開始
  IN_PROGRESS // Info: (20260810 - Julian) 進行中
  COMPLETED   // Info: (20260810 - Julian) 已完成
  CANCELLED   // Info: (20260810 - Julian) 已取消
}

enum OffboardingStatus {
  PENDING     // Info: (20260810 - Julian) 待處理
  IN_PROGRESS // Info: (20260810 - Julian) 交接中
  COMPLETED   // Info: (20260810 - Julian) 已完成
  REJECTED    // Info: (20260810 - Julian) 駁回
}

enum ProcessTaskType {
  ONBOARDING  // Info: (20260810 - Julian) 報到任務
  OFFBOARDING // Info: (20260810 - Julian) 離職交接任務
}

enum ProcessTaskStatus {
  PENDING     // Info: (20260810 - Julian) 待處理
  COMPLETED   // Info: (20260810 - Julian) 已完成
  SKIPPED     // Info: (20260810 - Julian) 跳過
}

enum DocumentCategory {
  CONTRACT    // Info: (20260810 - Julian) 勞動契約
  NDA         // Info: (20260810 - Julian) 保密協定
  CERTIFICATE // Info: (20260810 - Julian) 證照圖檔
  OTHER       // Info: (20260810 - Julian) 其他
}

// Info: (20260810 - Julian) 報到與離職的共通任務清單 (Task Checklist)
model ProcessTask {
  id                  String             @id @default(uuid())
  taskType            ProcessTaskType    @map("task_type") // Info: (20260810 - Julian) 區分是 ONBOARDING 還是 OFFBOARDING
  title               String             // Info: (20260810 - Julian) 任務名稱 (例: 發放門禁卡、收回電腦、退健保)
  description         String?
  status              ProcessTaskStatus  @default(PENDING)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260810 - Julian) 負責處理該任務的人 (例: IT 部門人員、HR)
  assigneeId          String?            @map("assignee_id")
  assignee            Employee?          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  completedAt         DateTime?          @map("completed_at")

  // Info: (20260810 - Julian) 歸屬於哪個報到流程或離職流程
  onboardingProcessId  String?            @map("onboarding_process_id")
  onboardingProcess    OnboardingProcess? @relation(fields: [onboardingProcessId], references: [id], onDelete: Cascade)

  offboardingProcessId String?             @map("offboarding_process_id")
  offboardingProcess   OffboardingProcess? @relation(fields: [offboardingProcessId], references: [id], onDelete: Cascade)

  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([onboardingProcessId])
  @@index([offboardingProcessId])
  @@index([assigneeId])
  @@map("process_task")
}

// Info: (20260810 - Julian) 新人報到流程檔
model OnboardingProcess {
  id           String           @id @default(uuid())
  employeeId   String           @unique @map("employee_id") // Info: (20260810 - Julian) 一個員工對應一個報到流程
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  status       OnboardingStatus @default(NOT_STARTED)
  startDate    DateTime         @map("start_date") // Info: (20260810 - Julian) 預計/實際報到日
  completedAt  DateTime?        @map("completed_at") // Info: (20260810 - Julian) 完成時間

  // Info: (20260810 - Julian) 關聯至細項任務
  tasks        ProcessTask[]

  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@map("onboarding_process")
}

// Info: (20260810 - Julian) 試用期考核紀錄
model ProbationReview {
  id           String    @id @default(uuid())
  employeeId   String    @unique @map("employee_id")
  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  reviewerId   String?   @map("reviewer_id") // Info: (20260810 - Julian) 考核主管 ID
  reviewer     Employee? @relation("ProbationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  reviewDate   DateTime? @map("review_date") // Info: (20260810 - Julian) 考核日期
  score        Int?      // Info: (20260810 - Julian) 評分 (例: 1-100)
  comment      String?   // Info: (20260810 - Julian) 考核評語
  result       String?   // Info: (20260810 - Julian) 考核結果 (例: PASS, EXTEND, FAIL)

  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([reviewerId])
  @@map("probation_review")
}

// Info: (20260810 - Julian) 離職申請與退保流程檔
model OffboardingProcess {
  id             String            @id @default(uuid())
  employeeId     String            @unique @map("employee_id")
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  status         OffboardingStatus @default(PENDING)

  reason         String?           // Info: (20260810 - Julian) 離職原因
  expectedDate   DateTime          @map("expected_date") // Info: (20260810 - Julian) 預計離職日
  actualDate     DateTime?         @map("actual_date") // Info: (20260810 - Julian) 實際離職日
  insuranceOffAt DateTime?         @map("insurance_off_at") // Info: (20260810 - Julian) 勞健保退保生效日

  // Info: (20260810 - Julian) 關聯至交接細項任務
  tasks          ProcessTask[]

  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@map("offboarding_process")
}

// Info: (20260810 - Julian) 合約與文件管理 (Documents & Contracts)
model EmployeeDocument {
  id          String           @id @default(uuid())
  employeeId  String           @map("employee_id")
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260811 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  title       String           // Info: (20260810 - Julian) 文件名稱 (例: 2026 勞動契約)
  category    DocumentCategory // Info: (20260810 - Julian) 文件分類
  fileId      String?          @map("file_id")
  file        File?            @relation(fields: [fileId], references: [id])

  expiredAt   DateTime?        @map("expired_at") // Info: (20260810 - Julian) 文件到期日 (如證照過期日、合約續約日)

  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  @@index([accountBookId])
  @@index([employeeId])
  @@map("employee_document")
}
