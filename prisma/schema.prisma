/**
 * Info: (20260809 - Luphia) 訂閱方案額度：系統設定值，由 DB 保存而非環境變數。
 * 額度屬營運設定（可由後台調整、需變更軌跡、多實例一致），非部署環境差異；
 * 且 env 於 client bundle 讀不到，會造成 SSR 與水合結果不一致。
 * 查無方案設定列時，以 src/constants/subscription_quota.ts 的預設值 fail-safe。
 */
model SubscriptionPlanQuota {
  id        String   @id @default(uuid())
  planId    String   @unique @map("plan_id") // Info: (20260809 - Luphia) PLAN 常數 (free/team/business)
  per5h     Int      @map("per_5h")
  perWeek   Int      @map("per_week")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("subscription_plan_quota")
}

/**
 * Info: (20260809 - Luphia) 系統設定（DB 為準，取代大部分 .env 變更）。
 * 秘密值（如 OAuth client secret）以 AES-256-GCM 加密後存放，明文永不落盤。
 * 完整性由 SystemSettingManifest 的全集簽章保護——單獨改這張表會導致 digest 對不上而被拒用。
 */
model SystemSetting {
  key        String   @id
  value      String
  isSecret   Boolean  @default(false) @map("is_secret")
  iv         String?
  authTag    String?  @map("auth_tag")
  keyVersion Int?     @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("system_setting")
}

/**
 * Info: (20260809 - Luphia) 系統設定的全集簽章（單列）。
 *
 * 與 .env 的 SUPER_ADMIN_SIGNATURE 同構：把所有設定的「明文」鍵值排序串接成
 * canonical string，SHA-256 後當作 WebAuthn challenge，由 SUPER_ADMIN 的 passkey 簽署。
 *
 * 之所以簽全集而非逐列：逐列簽章擋不住「整列刪除」與「換回舊值」，
 * 只有涵蓋全集的 digest 才能偵測新增／刪除。version 單調遞增以緩解 rollback
 * （完全防堵需 DB 以外的錨點，見 ADR 017）。
 */
model SystemSettingManifest {
  key       String   @id @default("default")
  digest    String
  signature String
  signedBy  String   @map("signed_by")
  version   Int
  signedAt  DateTime @default(now()) @map("signed_at")

  @@map("system_setting_manifest")
}

// Info: (20260809 - Luphia) 設定變更稽核軌跡：保留每一版的 digest 與簽章，供事後追查與 version 單調性檢查
model SystemSettingAudit {
  id        String   @id @default(uuid())
  version   Int      @unique
  digest    String
  signature String
  signedBy  String   @map("signed_by")
  // Info: (20260811 - Luphia) 逗號串接：目前 key 全部來自 SystemSettingKey 常數，不含逗號
  changedKeys String   @map("changed_keys")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("system_setting_audit")
}

/**
 * Info: (20260809 - Luphia) 費思計費設定：系統設定值，由 DB 保存而非環境變數（同 SubscriptionPlanQuota）。
 * 單列設定（singleton），以固定主鍵 "default" 保證唯一。
 * 查無設定列時，以 src/constants/llm.ts 的 DEFAULT_FAITH_BILLING fail-safe。
 */
model FaithBillingSetting {
  key                     String   @id @default("default")
  tokensPerCredit         Int      @map("tokens_per_credit")
  maxOutputTokens         Int      @map("max_output_tokens")
  imageInputTokenEstimate Int      @map("image_input_token_estimate")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  @@map("faith_billing_setting")
}

model TeamLedgerAnchor {
