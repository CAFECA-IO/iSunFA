/**
 * Info: (20260813 - Julian) ========== 簽到系統 (Time & Attendance) ==========
 *
 * ## 與 `Checkin` 無關
 *
 * 本區塊的四張表一律以 `Attendance*` / `WorkLocation` / `ShiftPattern` 命名。
 * 上面那個 `model Checkin` 是**使用者每日登入簽到**，與員工出勤沒有任何關係。
 *
 * ## 三個貫穿本區塊的決策
 *
 * 1. **到班的定義是「人在登記的地點」** —— 座標未落入任何圍欄的打卡會在 API 層
 *    被 403 擋掉，不會寫進資料庫。因此 `AttendancePunch.workLocationId` 必填，
 *    而「現場有幾個人」這個數字才有意義。
 * 2. **打卡紀錄不可變** —— repository 不提供 update / delete。出勤紀錄是法定文件
 *    （⚠️ 條號待法務核對），可被 UPDATE 的紀錄在稽核上等於沒有紀錄。
 * 3. **位置是個資** —— 座標以 AES-256-GCM 加密入庫（ADR 018 Tier 2）。
 *    「某人某時在某座標」是行蹤資料，敏感度不低於通訊地址：住址是靜態的一個點，
 *    打卡座標序列是動態的行蹤。查詢一律改讀非敏感的 `workLocationId`，
 *    **不要為了查詢把座標改回明文**（比照 ADR 018 §7 對 birthday 的處置）。
 *
 * 完整脈絡見 `documents/architecture/time_attendance_module_plan.md`
 * 與 `documents/architecture/attendance_demo_plan.md`。
 */

// Info: (20260813 - Julian) 打卡類型
enum PunchType {
  CLOCK_IN  // Info: (20260813 - Julian) 上班
  CLOCK_OUT // Info: (20260813 - Julian) 下班
}

/**
 * Info: (20260813 - Julian) 打卡的定位證據來源。
 *
 * Demo 只產生 GPS，三個值一次定義完：之後補上網段驗證與補打卡時，
 * 加的是資料不是欄位型別，不需要 migration 改 enum。
 */
enum PunchVerification {
  GPS        // Info: (20260813 - Julian) 瀏覽器定位，座標須落入圍欄
  NETWORK    // Info: (20260813 - Julian) 網段 / BSSID 白名單（demo 未實作）
  CORRECTION // Info: (20260813 - Julian) 補登申請單核准後產生（demo 未實作）
}

/**
 * Info: (20260813 - Julian) 排班日的性質。判定引擎依此決定當天是否需要出勤。
 *
 * ToDo: (20260813 - Julian) 工程場景需要 SUSPENDED（因雨／颱風／災害停工）。
 * 那既不是例假、不是休息日、不是國定假日，也不是個人請假 ——
 * 它是機關單方面免除當日出勤義務，而且在工程業是常態不是例外。
 * Demo 暫借 HOLIDAY（對判定引擎的效果相同），但正式版會讓
 * 「今年停工幾天」與「今年國定假日幾天」混在同一個值裡，
 * 而前者是工期展延與契約計價的依據。屆時一併加上 suspensionReason。
 */
enum WorkDayType {
  WORK        // Info: (20260813 - Julian) 上班日，必定掛一個班別
  REGULAR_OFF // Info: (20260813 - Julian) 例假
  REST_DAY    // Info: (20260813 - Julian) 休息日
  HOLIDAY     // Info: (20260813 - Julian) 國定假日
  LEAVE       // Info: (20260813 - Julian) 請假（銜接未來的假勤模組）
}

/**
 * Info: (20260813 - Julian) 打卡地點與地理圍欄。
 *
 * 座標型別取 Float，與既有的 Seaport / Airport 一致：它不是財務金額也不是
 * 碳排當量，不適用 CLAUDE.md §2 的 Decimal 規則，且 Haversine 本身就是浮點運算。
 *
 * ToDo: (20260813 - Julian) 圓形圍欄對線形工程（道路、管線）不合用 ——
 * 一條 3 公里的管線要用圓涵蓋，半徑得 1.5 公里以上，那個圓會把沿線兩側
 * 大片無關區域都算成工地。線形工程需要的是沿中心線的帶狀範圍（PostGIS ST_DWithin）。
 */
model WorkLocation {
  id   String @id @default(uuid())
  code String // Info: (20260813 - Julian) 地點代號 (例: LOC-A)，唯一性以帳本為範圍
  name String // Info: (20260813 - Julian) 地點名稱 (例: 大漢溪橋梁改建工程 工區)

  // Info: (20260813 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  latitude     Float
  longitude    Float
  // Info: (20260813 - Julian) 圍欄半徑（公尺）。正式上線前必須實地量測，見計畫書 §D6
  radiusMeters Int   @map("radius_meters")

  punches AttendancePunch[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@map("work_location")
}

/**
 * Info: (20260813 - Julian) 班別定義。**刻意沒有 shiftType 判別欄位。**
 *
 * ## 固定班表是彈性班表的特例
 *
 * 固定班表就是「彈性窗收縮到與核心時間重合」的彈性班表：
 *   工地日班   = 窗 07:30–17:00、核心 07:30–17:00
 *   工程師彈性 = 窗 07:00–20:00、核心 10:00–16:00
 *
 * 型別由值決定（windowStart == coreStart && windowEnd == coreEnd ⇒ 固定班），
 * 存一個可以與這六個欄位矛盾的判別欄位，它唯一能做的事就是說謊 ——
 * 判準同 ADR 019 對 ProcessTaskType 的處置。UI 需要標籤時由 service 以
 * `deriveShiftPatternKind()` 算出 `ShiftPatternKind`，**不可寫回資料庫**。
 *
 * 這換到的是：判定引擎沒有任何 `switch (shiftType)`，四條規則覆蓋兩種制度。
 * 要加第三種工時制度時，改的是這六個欄位的值，不是程式碼。
 *
 * ## 為什麼時刻用 Int 而不是 DateTime
 *
 * 「09:00」是時刻概念不是時間點。用 DateTime 會被迫綁一個沒有意義的日期，
 * 而那個日期會在時區轉換時產生真實的偏移。Int 分鐘（0–2879，>= 1440 表次日）
 * 沒有這個問題，且跨日班（20:00 → 次日 05:00 = 1200 → 1740）的表達是自然的。
 */
model ShiftPattern {
  id   String @id @default(uuid())
  code String // Info: (20260813 - Julian) 班別代號 (例: SITE-DAY)，唯一性以帳本為範圍
  name String // Info: (20260813 - Julian) 班別名稱 (例: 工地日班)

  // Info: (20260813 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  // Info: (20260813 - Julian) 六個欄位全部 NOT NULL —— 沒有「只對某一種制度有意義」的欄位
  windowStartMinute   Int @map("window_start_minute")   // Info: (20260813 - Julian) 最早可認列的上班時刻
  windowEndMinute     Int @map("window_end_minute")     // Info: (20260813 - Julian) 最晚可認列的下班時刻
  coreStartMinute     Int @map("core_start_minute")     // Info: (20260813 - Julian) 遲到判定基準
  coreEndMinute       Int @map("core_end_minute")       // Info: (20260813 - Julian) 早退判定基準
  requiredWorkMinutes Int @map("required_work_minutes") // Info: (20260813 - Julian) 應工作分鐘（不含休息）
  breakMinutes        Int @map("break_minutes")         // Info: (20260813 - Julian) 法定／約定休息

  shiftDays EmployeeShiftDay[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Info: (20260813 - Julian) 銷假徵詢指定的班別
  leaveRecalls LeaveRecall[]

  @@unique([accountBookId, code])
  @@index([accountBookId])
  @@map("shift_pattern")
}

/**
 * Info: (20260813 - Julian) 逐日排班／劃休。
 *
 * ## 為什麼不拆成 ScheduledWorkDay / ScheduledOffDay 兩張表
 *
 * `dayType` 與 `shiftPatternId` 確實可以互相矛盾（上班日沒班別、休假日卻掛班別），
 * 表面上與 ADR 019 的 ProcessTask 同型。但拆表在這裡會**弄丟下面那條唯一約束**：
 * 兩張表各自唯一，跨表無法約束，於是「同一人同一天既排班又排休」變成新的非法狀態
 * —— 而那正是 ADR 019 §1 表格裡評為「最惡劣」的第 3 種（兩個互相矛盾的事實）。
 *
 * **判準不是「有沒有 discriminator 欄位」，是「拆完之後非法狀態的總量有沒有變少」。**
 * 這裡沒有，所以維持單表，由 `assertSchedulableDay` 擋在 repository（唯一 DB 閘口）。
 * 完整論證見計畫書 §D2。
 */
model EmployeeShiftDay {
  id String @id @default(uuid())

  // Info: (20260813 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  // Info: (20260813 - Julian) "YYYY-MM-DD"，與 AttendancePunch.workDate 同型別同語意
  workDate String      @map("work_date")
  dayType  WorkDayType @map("day_type")

  // Info: (20260813 - Julian) dayType = WORK 時必填，其餘必為 null（assertSchedulableDay）
  // Info: (20260813 - Julian) Restrict：班別被刪不可讓歷史排班的班別靜默變成 null
  shiftPatternId String?       @map("shift_pattern_id")
  shiftPattern   ShiftPattern? @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Info: (20260813 - Julian) 本模組最重要的一條約束：一人一天只有一筆排班。
  // Info: (20260813 - Julian) 它擋掉的是排班表最常見的操作錯誤 —— 重複匯入
  @@unique([accountBookId, employeeId, workDate])
  @@index([accountBookId, workDate])
  @@index([employeeId])
  @@map("employee_shift_day")
}

/**
 * Info: (20260813 - Julian) 打卡紀錄。**Append-Only**：repository 不提供 update / delete。
 *
 * ## 為什麼每一筆都掛得上地點
 *
 * 圍欄外一律拒絕（計畫書 §D6）：座標未落入任何圍欄的打卡不會走到寫入這一步。
 * 因此 `workLocationId` 必填，「現場有幾個人」這個數字才可信 ——
 * 若允許圍欄外打卡，那個數字沒有意義。
 *
 * ## 為什麼位置是密文而距離是明文
 *
 * 座標是行蹤（Tier 2 機密）；`distanceMeters` 是「有多接近」不是「在哪裡」，
 * 且爭議發生時「當時距離中心 87 公尺」是免解密就能回答的關鍵事實。
 *
 * ## 為什麼不拆成 GpsPunch / NetworkPunch / CorrectionPunch
 *
 * ADR 019 拆表的代價是「我的待辦要查兩張表」，那是可接受的。這裡拆會變成三張表，
 * 而本表是全模組讀取最頻繁的一張（每日判定 × 全員 × 現場人數看板）。
 * 因此改由不變式擋在寫入端，理由與 hr_pii_invariant 同形。
 *
 * ## Demo 版與正式版的差異
 *
 * ToDo: (20260813 - Julian) 正式版需補：correctionRequestId（補登來源）、
 * supersededById（被哪一筆取代，自關聯 @unique）、clientIpCipher（網段驗證）。
 * 屆時 workLocationId 與 piiKeyVersion 需放寬為可空 —— 補登發生在事後，
 * 當下沒有位置也沒有密文，而「有密文卻沒有代次」與其反方向都由
 * assertStorablePii 擋。加的是欄位，不是改欄位。
 */
model AttendancePunch {
  // Info: (20260813 - Julian) 刻意沒有 @default(uuid())：id 是 PII 加密 AAD 的一部分，
  // Info: (20260813 - Julian) 而加密發生在 insert 之前，等不到資料庫產生。必須由應用層 randomUUID()。見 ADR 018 §3
  id String @id

  // Info: (20260813 - Julian) 隸屬的帳本 (租戶 Root Node)
  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  punchType    PunchType         @map("punch_type")
  verification PunchVerification
  // Info: (20260813 - Julian) 伺服器時間，絕不接受 client 傳入（護欄 G1）
  punchedAt    DateTime          @map("punched_at")
  // Info: (20260813 - Julian) 歸屬工作日 "YYYY-MM-DD"，跨夜班靠它分組；寫入時由 service 決定論固化
  workDate     String            @map("work_date")

  // Info: (20260813 - Julian) 命中的圍欄。Restrict：地點停用應改設有效期，不是刪除 ——
  // Info: (20260813 - Julian) 讓歷史打卡的地點變成 null 等於靜默改寫過去的出勤事實
  workLocationId String       @map("work_location_id")
  workLocation   WorkLocation @relation(fields: [workLocationId], references: [id], onDelete: Restrict)

  // Info: (20260813 - Julian) --- 位置證據（Tier 2 機密，密文入庫）---
  latitudeCipher  String @map("latitude_cipher")
  longitudeCipher String @map("longitude_cipher")
  // Info: (20260813 - Julian) 定位品質與離圍欄中心的距離，皆明文：不含位置本身
  accuracyMeters  Int?   @map("accuracy_meters")
  distanceMeters  Int    @map("distance_meters")

  // Info: (20260813 - Julian) 個資封裝參數，語意同 Employee
  piiAlgorithm  String @default("AES-256-GCM") @map("pii_algorithm")
  // Info: (20260813 - Julian) 非空：本表兩個密文欄位都是必填的，所以代次必然存在。
  // Info: (20260813 - Julian) 由資料庫擋而不是只靠 assertStorablePii —— 用 raw SQL 的
  // Info: (20260813 - Julian) 輪替腳本同樣繞過 TS 守衛，只有 NOT NULL 攔得住（ADR 018 §5）
  piiKeyVersion Int    @map("pii_key_version")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([accountBookId, employeeId, workDate])
  @@index([accountBookId, workDate])
  @@index([workLocationId])
  @@map("attendance_punch")
}

// Info: (20260813 - Julian) ── 假勤（銷假徵詢）───────────────────────────────

/**
 * Info: (20260813 - Julian) 假別。
 *
 * 只是分類，不帶任何規則 —— 時數扣抵、特休年度結算、給薪比例都屬於薪資模組
 * （母文件 §5.3 的跨模組邊界）。這裡放假別，是因為**銷假的合法性依假別而不同**：
 * 特休依勞基法 §38 III 由勞工排定，事假病假不是。
 *
 * ToDo: (20260813 - Julian) 正式版需要一張假別設定表（是否給薪、年度額度、
 * 可否銷假、需否附證明），而不是寫死的 enum。Demo 階段用 enum 是因為
 * 一張只有七列且不會被編輯的表，比 enum 貴而不多任何一分保證。
 */
enum LeaveType {
  ANNUAL      // Info: (20260813 - Julian) 特別休假
  PERSONAL    // Info: (20260813 - Julian) 事假
  SICK        // Info: (20260813 - Julian) 普通傷病假
  OFFICIAL    // Info: (20260813 - Julian) 公假
  MARRIAGE    // Info: (20260813 - Julian) 婚假
  BEREAVEMENT // Info: (20260813 - Julian) 喪假
  OTHER       // Info: (20260813 - Julian) 其他
}

/**
 * Info: (20260813 - Julian) 假單狀態。
 *
 * **沒有 RECALLED。** 銷假是逐日的（見 LeaveDay 的說明），
 * 整張假單不會因為其中一天被銷而改變狀態 —— 其餘的日子仍然生效。
 * 把「部分被銷」寫成假單層級的狀態，等於宣稱一件不成立的事。
 */
enum LeaveRequestStatus {
  PENDING   // Info: (20260813 - Julian) 待核准
  APPROVED  // Info: (20260813 - Julian) 已核准，生效中
  REJECTED  // Info: (20260813 - Julian) 未核准
  WITHDRAWN // Info: (20260813 - Julian) 申請人自行撤回
}

/**
 * Info: (20260813 - Julian) 銷假徵詢的狀態。
 *
 * ToDo: (20260813 - Julian) 缺 EXPIRED：日子過了而對方始終沒回應的徵詢，
 * 目前會永遠停在 PENDING。要嘛加排程把它收掉，要嘛在讀取時依 workDate 推導。
 * Demo 期間兩者都不做，因為演示的徵詢在三分鐘內就會被回應。
 */
enum LeaveRecallStatus {
  PENDING  // Info: (20260813 - Julian) 已發出，等待員工回應。**此期間假仍然生效**
  ACCEPTED // Info: (20260813 - Julian) 員工同意，該日已改回上班日
  DECLINED // Info: (20260813 - Julian) 員工婉拒，假單原封不動
}

/**
 * Info: (20260813 - Julian) 假單本體：回答「為什麼不用來」。
 *
 * 判定引擎讀的仍然是 `EmployeeShiftDay`，不是這張表 ——
 * 假單核准時**投影**成 `dayType = LEAVE`，銷假時投影回 `WORK`。
 * 不讓引擎直接讀假單，是為了維持它的純函數性質（計畫書 §2.5）：
 * 多一個資料來源，就多一組「兩邊說法不一致」的可能。
 */
model LeaveRequest {
  id String @id @default(uuid())

  accountBookId String      @map("account_book_id")
  accountBook   AccountBook @relation(fields: [accountBookId], references: [id])

  employeeId String   @map("employee_id")
  employee   Employee @relation("LeaveRequestEmployee", fields: [employeeId], references: [id], onDelete: Cascade)

  leaveType LeaveType          @map("leave_type")
  // Info: (20260813 - Julian) 請假事由。非空：一張沒有理由的假單，事後沒有人能判斷它合不合理
  reason    String
  status    LeaveRequestStatus @default(PENDING)

  // Info: (20260813 - Julian) SetNull：核准者離職不該讓假單一起消失，但「誰核准的」會因此變成 null。
  // Info: (20260813 - Julian) 正式版要留下不可變的核准者快照（姓名與工號），這裡是 demo 的取捨
  decidedByEmployeeId String?   @map("decided_by_employee_id")
  decidedBy           Employee? @relation("LeaveRequestDecider", fields: [decidedByEmployeeId], references: [id], onDelete: SetNull)
  decidedAt           DateTime? @map("decided_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  days LeaveDay[]

  @@index([accountBookId, employeeId])
  @@index([accountBookId, status])
  @@map("leave_request")
}

/**
 * Info: (20260813 - Julian) 假單逐日展開：回答「哪幾天不用來」，也是與排班對位的那一層。
 *
 * ## 為什麼要展開成逐日，而不是在假單上放起迄
 *
 * 排班是逐日的，銷假也是逐日的 —— 工地缺的是**明天**的人，不是整週的人。
 * 起迄區間無法表示「這五天裡的第三天被銷了、其餘四天仍然有效」，
 * 而那正是這個需求最常見的情況。
 *
 * ## `activeKey`：讓「同一人同一天有兩張生效假單」不可表示
 *
 * 值為 `"<employeeId>:<workDate>"`，且**只在假單生效時填入**，其餘狀態為 null。
 * Postgres 的 unique index 不約束 NULL，因此已駁回／已撤回／已銷假的日子可以
 * 重複無限多筆，而生效中的只能有一筆 —— 這是 partial unique index 的可攜寫法。
 *
 * 銷假時把它設回 null，**不刪列**：刪掉的話「他曾經請過這天、後來被銷了」
 * 這個事實就消失了，而那正是主管機關會查的東西。
 *
 * 刻意不在本表另存 `employeeId`：它可以從 `leaveRequest` 取得，
 * 存第二份就等於允許「明細的員工與假單的員工不一致」這種非法狀態存在（ADR 019）。
 * 代價是查詢要 join 一層，在這個資料量下不值得為它交換一個新的矛盾來源。
 */
model LeaveDay {
  id String @id @default(uuid())

  leaveRequestId String       @map("leave_request_id")
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  // Info: (20260813 - Julian) "YYYY-MM-DD"，與 EmployeeShiftDay.workDate 同型別同語意
  workDate String @map("work_date")

  // Info: (20260813 - Julian) 生效中才有值（見上方說明）
  activeKey String? @unique @map("active_key")

  // Info: (20260813 - Julian) 被銷假的時點。null 表示未被銷 —— 與 activeKey 是兩件事：
  // Info: (20260813 - Julian) 假單被駁回的日子 activeKey 也是 null，但它從來沒有被銷過
  recalledAt DateTime? @map("recalled_at")

  createdAt DateTime @default(now()) @map("created_at")

  recalls LeaveRecall[]

  @@unique([leaveRequestId, workDate])
  @@index([workDate])
  @@map("leave_day")
}

/**
 * Info: (20260813 - Julian) 銷假徵詢：回答「誰要求誰回來、對方答應了嗎」。
 *
 * ## 為什麼是獨立的表，不是 LeaveRequest 的一個狀態
 *
 * 徵詢會被婉拒，而婉拒之後假單回到原狀 —— 若做成狀態，第二次徵詢會抹掉第一次，
 * 「這個人被要求回來過三次、拒絕了兩次」這個事實無處可存。
 * 而在人手不足的爭議裡，那正是最該留下的部分。
 *
 * ## 為什麼徵詢期間假仍然生效
 *
 * 主管按下去的當下若立刻把該日改回 WORK，員工還沒回應就已經是「排了班卻沒到」，
 * 系統會把他算進未到工。那是拿系統事實去施壓，而勞基法 §38 III 要的是協商。
 * 因此 `EmployeeShiftDay` 的寫入只發生在 `ACCEPTED` 的那一刻。
 *
 * ## `pendingLeaveDayId`
 *
 * 與 `LeaveDay.activeKey` 同一手法：只在 PENDING 時填入 `leaveDayId`，
 * 讓「同一天同時掛著兩張待回應的徵詢」不可表示。被拒絕過的徵詢可以有很多筆。
 */
model LeaveRecall {
  id String @id @default(uuid())

  leaveDayId String   @map("leave_day_id")
  leaveDay   LeaveDay @relation(fields: [leaveDayId], references: [id], onDelete: Cascade)

  // Info: (20260813 - Julian) 僅 PENDING 時等於 leaveDayId，其餘為 null（見上方說明）
  pendingLeaveDayId String? @unique @map("pending_leave_day_id")

  requestedByEmployeeId String   @map("requested_by_employee_id")
  requestedBy           Employee @relation("LeaveRecallRequester", fields: [requestedByEmployeeId], references: [id], onDelete: Cascade)

  /**
   * Info: (20260813 - Julian) 要他回來上哪一班。非空。
   *
   * 「請你回來上班」不是一個完整的請求 —— 員工同意的必須是一個具體的班別，
   * 而不是一個待定的時間。它也讓「同意之後那天沒有班別」不可表示：
   * 投影回 `EmployeeShiftDay` 時 `dayType = WORK` 與 `shiftPatternId` 一起寫入，
   * `assertSchedulableDay` 因此永遠成立。
   *
   * Restrict：班別被刪不可讓歷史徵詢的班別靜默變成 null，語意同 EmployeeShiftDay。
   */
  shiftPatternId String       @map("shift_pattern_id")
  shiftPattern   ShiftPattern @relation(fields: [shiftPatternId], references: [id], onDelete: Restrict)

  // Info: (20260813 - Julian) 「企業經營上之急迫需求」的書面記載。非空 —— 沒有理由的徵詢就是命令
  reason String
  status LeaveRecallStatus @default(PENDING)

  respondedAt  DateTime? @map("responded_at")
  // Info: (20260813 - Julian) 員工回應時可附一句話；婉拒的理由對後續協商有意義
  responseNote String?   @map("response_note")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([leaveDayId])
  @@index([requestedByEmployeeId])
  @@map("leave_recall")
}
