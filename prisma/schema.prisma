model Order {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  user            User     @relation(fields: [userId], references: [id])
  type            String
  amount          BigInt
  unit            String   @default("ICP")
  data            Json
  status          String   @default("PENDING")
  challenge       String
  signature       String?
  transactionHash String?  @map("transaction_hash")
  mission         String?
  tokens          Int?     @default(0)
  /**
   * Info: (20260815 - Luphia) 冪等鍵升格為真欄位並加上唯一約束（PR #6652 第二輪 B-3 / C-9）。
   *
   * 原本只寫在 `data.idempotencyKey`（JSON path），資料庫層擋不住任何東西：
   * 「先查有沒有、沒有就建一張」在並發下兩邊都會通過——兩位管理員同時邀請同一個位址
   * 就是扣兩次款，後台連點發放點數也是同樣的形狀。
   * 唯一約束讓第二筆在 DB 層直接失敗（P2002），由呼叫端當成重放處理。
   *
   * 可為 null：不需要冪等保護的訂單（一般購點、分析報告）不帶鍵，
   * 而 Postgres 的唯一約束允許多個 null。
   */
  idempotencyKey  String?  @unique @map("idempotency_key")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  analysis            Analysis[]
  paymentTransactions PaymentTransaction[]
  receipt             Receipt?

  @@map("order")
}

// Info: (20260128 - Luphia) Analysis 直接將 data 與 result 放在 mission 裡面
model Analysis {
