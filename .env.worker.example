#
# Worker 節點專屬設定（`.env.worker`）
#
# worker 不使用系統的 `.env`，也不讀取資料庫 —— 它只讀這一份。
# 複製本檔為 `.env.worker` 後填值：cp .env.worker.example .env.worker
#
# 為什麼獨立一份：
#   1. `MissionExecutor` 處理使用者上傳的憑證內容，依
#      documents/architecture/async_workers/00_async_worker_overview.md
#      它連主資料庫都不該連得到。與 web 節點共用 `.env` 會讓它看得到
#      DATABASE_URL / SECRET_VAULT_MASTER_KEY / SUPER_ADMIN_*，
#      而一個處理外部輸入的節點持有信任根，等於把那道隔離的意義抵銷掉。
#   2. 只保留 worker 真正用到的鍵，而不是整份 web 設定。
#   3. worker 本來就設計成可以放在另一台機器 —— 那時它不會有 web 的 `.env`。
#
# 這一份**不會**被 validateEnvDetailed() 當成必要鍵檢查（那支只讀 `.env.example`），
# 所以這裡可以照常寫成鍵值，缺鍵不會讓系統掉進「尚未初始化」狀態。
#
# 但運算節點啟動時會檢查三個必要鍵的**值**非空（NEXT_PUBLIC_RPC_URL、
# NEXT_PUBLIC_MISSION_BOARD_ADDRESS、STORAGE_DOMAIN；清單在 src/constants/worker_node.ts
# 的 COMPUTE_NODE_REQUIRED_ENV_KEYS），空值視同缺席、節點直接退出——照本檔 cp 過去
# 不填值是起不來的。檢查的是**本檔的解析結果**，shell 裡 export 的同名變數不算：
# 這個節點的設定只有這一份，檔內的值會覆寫 shell 的值。
# 也不要把系統 .env 整份複製進來：DATABASE_URL、POSTGRES_PASSWORD 等信任根會被
# 抹掉並印 error。
#

# LLM 金鑰。web 節點的正式來源是資料庫的 system_setting（/admin/settings），
# 但這個節點讀不到資料庫，因此對它而言金鑰就是部署環境差異。
# **/admin/settings 的輪替與撤銷對 worker 無效** ——
# 見 documents/engineering_guidelines/known_issues/executor_settings_isolation.md
# 選填（ADR 026 決策）：留空時需要 LLM 的任務會以 LLM_KEY_MISSING 明確失敗，
# 不需要 LLM 的任務（PRECOMPUTED）照常。
GEMINI_API_KEY=

# IPFS（Laria）儲存節點的網域，例如 https://storage.example.com。
# 跨節點邊界唯一的合法通道：planner 從這裡下載 mission.json、commitor 把 result.md
# 上傳到這裡。缺了每一次下載與上傳都打向空網域，而且 planner 對下載失敗不推進
# cursor——分機部署的第一個任務就會卡死全站。值與 web 節點的 .env 相同。
STORAGE_DOMAIN=

# 模型名稱。未設定時使用程式碼預設值（DEFAULT_GEMINI_MODEL）。
MODEL=

# 任務檔案的落地目錄（相對於 worker 的工作目錄）。未設定時預設 missions。
MISSION_DIR=

# MissionBoard 合約與 RPC（PR #6650 review 阻-1）。planner / commitor / closer
# 從這兩個鍵讀鏈上任務：純運算節點沒有系統 .env，少了它們 planner 每 10 秒對
# undefined address 拋錯、任務永遠不被領取。值與 web 節點的 .env 相同。
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_MISSION_BOARD_ADDRESS=
